# Normalize line endings in the repository; keep binaries binary.
* text=auto eol=lf

*.sln text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.dll binary
*.exe binary
*.7z binary
*.zip binary
*.mp4 binary
*.mkv binary
