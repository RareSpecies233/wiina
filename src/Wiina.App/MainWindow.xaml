<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wiina.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Wiina.App.Controls">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource AppBackgroundBrush}"
          PointerEntered="OnRootPointerEntered"
          PointerMoved="OnRootPointerMoved"
          PointerExited="OnRootPointerExited">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F11" Invoked="OnToggleFullscreen" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
            <KeyboardAccelerator Key="B" Modifiers="Control,Shift" Invoked="OnToggleSidebarAccel" />
            <KeyboardAccelerator Key="L" Modifiers="Control,Shift" Invoked="OnToggleLayoutAccel" />
            <KeyboardAccelerator Key="O" Modifiers="Control,Shift" Invoked="OnCycleOscAccel" />
            <KeyboardAccelerator Key="T" Modifiers="Control,Shift" Invoked="OnCycleThemeAccel" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Video layer. In docked mode this becomes row 1 only. -->
        <Grid x:Name="VideoFrame" Grid.RowSpan="3">
            <SwapChainPanel x:Name="VideoHost"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                <SwapChainPanel.RenderTransform>
                    <CompositeTransform x:Name="VideoTransform" />
                </SwapChainPanel.RenderTransform>
            </SwapChainPanel>
        </Grid>

        <controls:TitleBarView x:Name="TitleBar" Grid.Row="0" />

        <controls:OscBottomView x:Name="OscBottom"
                                Grid.Row="2"
                                Visibility="Collapsed" />

        <!-- Floating overlays: OSC, sidebars, time preview. Empty areas stay hit-test transparent. -->
        <Grid x:Name="OverlayLayer" Grid.RowSpan="3">
            <Canvas x:Name="OscCanvas" Grid.RowSpan="3">
                <controls:OscFloatingView x:Name="OscFloating" />
            </Canvas>
            <controls:SidebarHost x:Name="SidebarLeading"
                                  HorizontalAlignment="Left"
                                  Margin="0,40,0,0"
                                  Visibility="Collapsed" />
            <controls:SidebarHost x:Name="SidebarTrailing"
                                  HorizontalAlignment="Right"
                                  Margin="0,40,0,0"
                                  Visibility="Collapsed" />
            <Border x:Name="TimePreview"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Padding="10,6"
                    CornerRadius="8"
                    Background="{ThemeResource PanelBrush}"
                    BorderBrush="{ThemeResource PanelBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="TimePreviewChapter"
                               FontSize="11"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="TimePreviewText"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
