<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wiina.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
    xmlns:controls="using:Wiina.App.Controls">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource AppBackgroundBrush}"
          IsTabStop="True"
          PointerEntered="OnRootPointerEntered"
          PointerMoved="OnRootPointerMoved"
          PointerExited="OnRootPointerExited">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F11" Invoked="OnToggleFullscreen" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscape" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Video layer. In docked mode this becomes row 1 only. -->
        <Grid x:Name="VideoFrame" Grid.RowSpan="3" Background="Transparent" FlowDirection="LeftToRight">
            <controls:MpvVideoView x:Name="VideoHost"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top" />

            <!-- PiP placeholder: the swapchain currently lives in the PiP
                 window, so the main window keeps a compact restore surface. -->
            <Grid x:Name="PipPlaceholder"
                  Visibility="Collapsed"
                  Background="#F208090A">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="10">
                    <FontIcon Glyph="&#xE8B9;"
                              FontSize="36"
                              Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBlock x:Name="PipPlaceholderTitle"
                               loc:Loc.Text="ui.inPip"
                               FontSize="20"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="PipPlaceholderSubtitle"
                               loc:Loc.Text="ui.pipPlaying"
                               FontSize="12"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" />
                    <Button loc:Loc.Content="ui.restore"
                            Click="OnPipRestoreClick"
                            HorizontalAlignment="Center"
                            loc:Loc.AutomationName="ui.restorePip" />
                </StackPanel>
            </Grid>
        </Grid>

        <controls:TitleBarView x:Name="TitleBar"
                               Grid.Row="0"
                               Visibility="Collapsed" />

        <controls:OscBottomView x:Name="OscBottom"
                                Grid.Row="2"
                                FlowDirection="LeftToRight"
                                Visibility="Collapsed" />

        <!-- Floating overlays: OSC, sidebars, time preview. Empty areas stay hit-test transparent. -->
        <Grid x:Name="OverlayLayer" Grid.RowSpan="3">
            <Canvas x:Name="OscCanvas" Grid.RowSpan="3">
                <controls:OscFloatingView x:Name="OscFloating" FlowDirection="LeftToRight" />
            </Canvas>
            <controls:OscBottomView x:Name="OscTop"
                                    VerticalAlignment="Top"
                                    FlowDirection="LeftToRight"
                                    Visibility="Collapsed"
                                    PointerEntered="OnChromePointerEntered"
                                    PointerExited="OnChromePointerExited" />
            <controls:SidebarHost x:Name="SidebarLeading"
                                  HorizontalAlignment="Left"
                                  Margin="0,40,0,0"
                                  Visibility="Collapsed" />
            <controls:SidebarHost x:Name="SidebarTrailing"
                                  HorizontalAlignment="Right"
                                  Margin="0,40,0,0"
                                  Visibility="Collapsed" />
            <controls:ThumbnailPeek x:Name="ThumbnailPeek" />
            <controls:BufferIndicator x:Name="BufferStatus" />
            <controls:FullscreenInfo x:Name="FullscreenStatus" />
            <Border x:Name="TimePreview"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Padding="10,6"
                    CornerRadius="8"
                    Background="{ThemeResource PanelBrush}"
                    BorderBrush="{ThemeResource PanelBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    IsHitTestVisible="False">
                <StackPanel Spacing="2">
                    <TextBlock x:Name="TimePreviewChapter"
                               FontSize="11"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="TimePreviewText"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Mini / music mode covers the whole shell (Stage 6). Kept below the
             OSD so status messages remain visible. -->
        <controls:MiniPlayerView x:Name="MiniPlayer"
                                 Grid.RowSpan="3"
                                 Visibility="Collapsed" />

        <controls:OsdText x:Name="Osd"
                          Grid.RowSpan="3"
                          Margin="0,0,8,76"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom" />
    </Grid>
</Window>


