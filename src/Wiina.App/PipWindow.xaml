<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wiina.App.PipWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
    xmlns:controls="using:Wiina.App.Controls">

    <Grid x:Name="Root"
          Background="Black"
          PointerEntered="OnRootPointerEntered"
          PointerMoved="OnRootPointerMoved"
          PointerExited="OnRootPointerExited"
          Tapped="OnRootTapped"
          DoubleTapped="OnRootDoubleTapped">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
        </Grid.KeyboardAccelerators>

        <controls:MpvVideoView x:Name="VideoHost"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top" />

        <!-- Frameless drag strip: no caption buttons, just a grab area. -->
        <Grid x:Name="DragRegion"
              Height="28"
              VerticalAlignment="Top"
              Background="Transparent"
              Opacity="0">
            <FontIcon Glyph="&#xE76F;"
                      FontSize="10"
                      Foreground="#80FFFFFF"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
        </Grid>

        <Border x:Name="ControlStrip"
                VerticalAlignment="Bottom"
                Height="44"
                Background="#B3000000"
                Opacity="0"
                IsHitTestVisible="False"
                PointerEntered="OnControlStripPointerEntered"
                PointerExited="OnControlStripPointerExited">
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button x:Name="PlayPauseButton"
                        Width="36"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="16"
                        Content="&#xE768;"
                        Click="OnPlayPauseClick"
                        loc:Loc.ToolTip="ui.playPauseSlash"
                        loc:Loc.AutomationName="ui.playPause" />
                <Button x:Name="PinButton"
                        Width="36"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="16"
                        Content="&#xE718;"
                        Click="OnPinClick"
                        loc:Loc.ToolTip="ui.alwaysOnTop"
                        loc:Loc.AutomationName="ui.alwaysOnTop" />
                <Button x:Name="CloseButton"
                        Width="36"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="16"
                        Content="&#xE711;"
                        Click="OnCloseClick"
                        loc:Loc.ToolTip="ui.closePip"
                        loc:Loc.AutomationName="ui.closePip" />
            </StackPanel>
        </Border>

        <Border x:Name="HintBadge"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,34,0,0"
                Padding="10,5"
                CornerRadius="12"
                Background="#99000000"
                Opacity="0"
                IsHitTestVisible="False">
            <TextBlock loc:Loc.Text="ui.pipDoubleClick"
                       FontSize="11"
                       Foreground="#CCFFFFFF" />
        </Border>
    </Grid>
</Window>


