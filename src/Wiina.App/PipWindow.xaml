<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wiina.App.PipWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Wiina.App.Controls">

    <Grid x:Name="Root"
          Background="Black"
          RequestedTheme="Dark"
          PointerEntered="OnRootPointerEntered"
          PointerMoved="OnRootPointerMoved"
          PointerExited="OnRootPointerExited"
          Tapped="OnRootTapped"
          DoubleTapped="OnRootDoubleTapped">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
            <KeyboardAccelerator Key="Space" Invoked="OnSpaceAccelerator" />
        </Grid.KeyboardAccelerators>

        <controls:MpvVideoView x:Name="VideoHost"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top" />

        <!-- Frameless drag strip: no caption buttons, just a grab area. -->
        <Grid x:Name="DragRegion"
              Height="28"
              VerticalAlignment="Top"
              Background="Transparent">
            <FontIcon Glyph="&#xE76F;"
                      FontSize="10"
                      Foreground="#80FFFFFF"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
        </Grid>

        <Border x:Name="ControlStrip"
                VerticalAlignment="Bottom"
                Height="44"
                Background="#B3000000"
                PointerEntered="OnControlStripPointerEntered"
                PointerExited="OnControlStripPointerExited">
            <StackPanel Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button x:Name="PlayPauseButton"
                        Width="36"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="16"
                        Content="&#xE768;"
                        Click="OnPlayPauseClick"
                        ToolTipService.ToolTip="播放 / 暂停"
                        AutomationProperties.Name="播放或暂停" />
                <Button x:Name="RestoreButton"
                        Width="36"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="16"
                        Content="&#xE73F;"
                        Click="OnRestoreClick"
                        ToolTipService.ToolTip="返回主窗口"
                        AutomationProperties.Name="返回主窗口" />
                <Button x:Name="CloseButton"
                        Width="36"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="White"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="16"
                        Content="&#xE711;"
                        Click="OnCloseClick"
                        ToolTipService.ToolTip="关闭画中画"
                        AutomationProperties.Name="关闭画中画" />
            </StackPanel>
        </Border>

        <Border x:Name="HintBadge"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,34,0,0"
                Padding="10,5"
                CornerRadius="12"
                Background="#99000000"
                IsHitTestVisible="False">
            <TextBlock Text="画中画 · 双击返回"
                       FontSize="11"
                       Foreground="#CCFFFFFF" />
        </Border>
    </Grid>
</Window>
