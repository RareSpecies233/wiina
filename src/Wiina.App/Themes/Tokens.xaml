<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF08090A" />
            <SolidColorBrush x:Key="TitleBarBrush" Color="#B3000000" />
            <SolidColorBrush x:Key="TitleBarOpaqueBrush" Color="#FF101114" />
            <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="PanelBrush" Color="#FF15171B" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="CardBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF4CC2FF" />
            <SolidColorBrush x:Key="HoverBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="PressedBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SubtleBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="SliderTrackBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="SliderBufferBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SliderPlayedBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="SidebarTabSelectedBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="SidebarTabSelectedBorderBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="SidebarTabHoverBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SidebarRowCurrentBrush" Color="#1F4CC2FF" />
            <SolidColorBrush x:Key="SidebarRowHoverBrush" Color="#0DFFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFF7F7F7" />
            <SolidColorBrush x:Key="TitleBarBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="TitleBarOpaqueBrush" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="CardBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#14000000" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#99000000" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#66000000" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF005FB8" />
            <SolidColorBrush x:Key="HoverBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="PressedBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="SubtleBrush" Color="#08000000" />
            <SolidColorBrush x:Key="SliderTrackBrush" Color="#33000000" />
            <SolidColorBrush x:Key="SliderBufferBrush" Color="#4D000000" />
            <SolidColorBrush x:Key="SliderPlayedBrush" Color="#4D000000" />
            <SolidColorBrush x:Key="SliderThumbBrush" Color="#CC000000" />
            <SolidColorBrush x:Key="SidebarTabSelectedBrush" Color="#14000000" />
            <SolidColorBrush x:Key="SidebarTabSelectedBorderBrush" Color="#33000000" />
            <SolidColorBrush x:Key="SidebarTabHoverBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="SidebarRowCurrentBrush" Color="#1F005FB8" />
            <SolidColorBrush x:Key="SidebarRowHoverBrush" Color="#08000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="TitleBarHeight">40</x:Double>
    <x:Double x:Key="BottomOscHeight">64</x:Double>
    <x:Double x:Key="FloatingOscWidth">460</x:Double>
    <x:Double x:Key="FloatingOscHeight">64</x:Double>
    <x:Double x:Key="SidebarWidth">360</x:Double>
    <x:Double x:Key="SidebarTabHeight">52</x:Double>
    <x:Double x:Key="BodyFontSize">13</x:Double>
    <x:Double x:Key="CaptionFontSize">11</x:Double>
    <x:Double x:Key="TitleFontSize">13</x:Double>
    <x:Double x:Key="IconSize">14</x:Double>
    <x:Double x:Key="TitleBarButtonSize">32</x:Double>
    <x:Double x:Key="OscButtonSize">28</x:Double>

    <FontFamily x:Key="AppFont">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons</FontFamily>

    <CornerRadius x:Key="PanelCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ThumbCornerRadius">4</CornerRadius>
</ResourceDictionary>

