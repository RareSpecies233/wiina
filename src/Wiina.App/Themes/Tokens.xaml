<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF08090A" />
            <SolidColorBrush x:Key="TitleBarBrush" Color="#B3000000" />
            <SolidColorBrush x:Key="TitleBarOpaqueBrush" Color="#FF101114" />
            <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="PanelBrush" Color="#FF15171B" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="OsdBackgroundBrush" Color="#D9101114" />
            <SolidColorBrush x:Key="OsdProgressTrackBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ThumbnailBorderBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#B3000000" />
            <!-- Chrome over the video is an opaque solid block. Its colour is
                 the base below mixed with the system accent at runtime by
                 Services/ChromeTint.cs (issue 2: no capture, no Win2D blur). -->
            <SolidColorBrush x:Key="ChromeSolidBrush" Color="#FF15171B" />
            <SolidColorBrush x:Key="SettingsRailBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="SettingsPageWashBrush" Color="#4015171B" />
            <SolidColorBrush x:Key="SettingsCardWashBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="KeyChordChipBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="WindowTintBrush" Color="#66101114" />
            <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#F51A1B20" />
            <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="CaptionButtonPressedBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="#FFB01F14" />
            <SolidColorBrush x:Key="CardBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#1FFFFFFF" />
            <!-- White rounded tile behind the brand triangle (about window). -->
            <SolidColorBrush x:Key="BrandTileBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#80FFFFFF" />
            <!-- Follow the Windows accent color instead of a hard-coded cyan;
                 this drives OSD rails, locator underlines, pins and the native
                 slider value fill. -->
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="HoverBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="PressedBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SubtleBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="SliderTrackBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="SliderBufferBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SliderPlayedBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="SliderThumbBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="SidebarTabSelectedBrush" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="SidebarTabSelectedBorderBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="SidebarTabHoverBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SidebarRowCurrentBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
            <SolidColorBrush x:Key="SidebarRowHoverBrush" Color="#0DFFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FFF7F7F7" />
            <SolidColorBrush x:Key="TitleBarBrush" Color="#99FFFFFF" />
            <SolidColorBrush x:Key="TitleBarOpaqueBrush" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="TitleBarBorderBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="OsdBackgroundBrush" Color="#E6F3F3F3" />
            <SolidColorBrush x:Key="OsdProgressTrackBrush" Color="#22000000" />
            <SolidColorBrush x:Key="ThumbnailBorderBrush" Color="#99000000" />
            <SolidColorBrush x:Key="StatusBackgroundBrush" Color="#CCF3F3F3" />
            <SolidColorBrush x:Key="ChromeSolidBrush" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="SettingsRailBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="SettingsPageWashBrush" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="SettingsCardWashBrush" Color="#14000000" />
            <SolidColorBrush x:Key="KeyChordChipBrush" Color="#08000000" />
            <SolidColorBrush x:Key="WindowTintBrush" Color="#66F3F3F3" />
            <SolidColorBrush x:Key="DialogSurfaceBrush" Color="#F5FAF9F6" />
            <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="#14000000" />
            <SolidColorBrush x:Key="CaptionButtonPressedBrush" Color="#26000000" />
            <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="#FFC42B1C" />
            <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="#FFB01F14" />
            <SolidColorBrush x:Key="CardBrush" Color="#CCFFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#14000000" />
            <SolidColorBrush x:Key="BrandTileBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#99000000" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="#66000000" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemAccentColor}" />
            <SolidColorBrush x:Key="HoverBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="PressedBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="SubtleBrush" Color="#08000000" />
            <SolidColorBrush x:Key="SliderTrackBrush" Color="#33000000" />
            <SolidColorBrush x:Key="SliderBufferBrush" Color="#4D000000" />
            <SolidColorBrush x:Key="SliderPlayedBrush" Color="#4D000000" />
            <SolidColorBrush x:Key="SliderThumbBrush" Color="#CC000000" />
            <SolidColorBrush x:Key="SidebarTabSelectedBrush" Color="#14000000" />
            <SolidColorBrush x:Key="SidebarTabSelectedBorderBrush" Color="#33000000" />
            <SolidColorBrush x:Key="SidebarTabHoverBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="SidebarRowCurrentBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
            <SolidColorBrush x:Key="SidebarRowHoverBrush" Color="#08000000" />
        </ResourceDictionary>

        <!-- High contrast: every panel/text/icon brush resolves to a system
             color so Windows contrast themes drive the whole shell. -->
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TitleBarBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TitleBarOpaqueBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TitleBarBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="PanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PanelBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OsdBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OsdProgressTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ThumbnailBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ChromeSolidBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SettingsRailBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SettingsPageWashBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SettingsCardWashBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="KeyChordChipBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CaptionButtonHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CaptionButtonPressedBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="CaptionCloseHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="CaptionClosePressedBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="WindowTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="DialogSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="BrandTileBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TertiaryTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="HoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="PressedBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
            <SolidColorBrush x:Key="SubtleBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SliderTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="SliderBufferBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="SliderPlayedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SliderThumbBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SidebarTabSelectedBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SidebarTabSelectedBorderBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SidebarTabHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SidebarRowCurrentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SidebarRowHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="TitleBarHeight">40</x:Double>
    <x:Double x:Key="BottomOscHeight">64</x:Double>
    <x:Double x:Key="FloatingOscWidth">460</x:Double>
    <x:Double x:Key="FloatingOscHeight">64</x:Double>
    <x:Double x:Key="SidebarWidth">360</x:Double>
    <x:Double x:Key="SidebarTabHeight">52</x:Double>
    <x:Double x:Key="BodyFontSize">13</x:Double>
    <x:Double x:Key="CaptionFontSize">11</x:Double>
    <x:Double x:Key="TitleFontSize">13</x:Double>
    <x:Double x:Key="IconSize">14</x:Double>
    <x:Double x:Key="TitleBarButtonSize">32</x:Double>
    <x:Double x:Key="CaptionButtonWidth">46</x:Double>
    <x:Double x:Key="CaptionButtonHeight">32</x:Double>
    <x:Double x:Key="OscButtonSize">28</x:Double>

    <FontFamily x:Key="AppFont">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons</FontFamily>

    <CornerRadius x:Key="PanelCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="ThumbCornerRadius">4</CornerRadius>
</ResourceDictionary>
