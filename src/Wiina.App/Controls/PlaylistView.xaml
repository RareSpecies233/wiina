<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.PlaylistView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="12,8,12,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button Style="{StaticResource OscIconButtonStyle}"
                        Content="&#xE710;"
                        Click="OnAddClick"
                        loc:Loc.ToolTip="ui.addFiles"
                        loc:Loc.AutomationName="ui.addFiles" />
                <Button Style="{StaticResource OscIconButtonStyle}"
                        Content="&#xE74D;"
                        Click="OnRemoveClick"
                        loc:Loc.ToolTip="ui.removeSelected"
                        loc:Loc.AutomationName="ui.removeSelected" />
                <Button Style="{StaticResource OscIconButtonStyle}"
                        Content="&#xE74A;"
                        Click="OnMoveUpClick"
                        loc:Loc.ToolTip="ui.moveUp"
                        loc:Loc.AutomationName="ui.moveUp" />
                <Button Style="{StaticResource OscIconButtonStyle}"
                        Content="&#xE74B;"
                        Click="OnMoveDownClick"
                        loc:Loc.ToolTip="ui.moveDown"
                        loc:Loc.AutomationName="ui.moveDown" />
                <Button Style="{StaticResource OscIconButtonStyle}"
                        Content="&#xE74E;"
                        Click="OnSaveClick"
                        loc:Loc.ToolTip="ui.saveM3u"
                        loc:Loc.AutomationName="ui.savePlaylist" />
            </StackPanel>

            <TextBlock x:Name="CountText"
                       Grid.Column="1"
                       HorizontalAlignment="Right"
                       Style="{StaticResource CaptionTextStyle}"
                       loc:Loc.Text="ui.zeroItemsShort" />
        </Grid>

        <ListView x:Name="ItemList"
                  Grid.Row="1"
                  SelectionMode="Extended"
                  CanDragItems="True"
                  CanReorderItems="True"
                  AllowDrop="True"
                  HorizontalContentAlignment="Stretch"
                  DoubleTapped="OnListDoubleTapped"
                  RightTapped="OnListRightTapped"
                  DragItemsStarting="OnDragItemsStarting"
                  DragItemsCompleted="OnDragItemsCompleted"
                  KeyDown="OnListKeyDown">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Height="46"
                          ColumnSpacing="8"
                          Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding IndicatorGlyph}"
                                   Foreground="{ThemeResource AccentBrush}"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                            <TextBlock Text="{Binding Title}"
                                       Style="{StaticResource BodyTextStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       FontWeight="{Binding TitleWeight}"
                                       MaxLines="1" />
                            <TextBlock Text="{Binding Meta}"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxLines="1" />
                            <ProgressBar Height="2"
                                         Minimum="0"
                                         Maximum="1"
                                         Value="{Binding Progress}"
                                         Visibility="{Binding ProgressVisibility}" />
                        </StackPanel>

                        <TextBlock Grid.Column="2"
                                   Text="{Binding IndexText}"
                                   Style="{StaticResource CaptionTextStyle}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyHint"
                   Grid.Row="1"
                   Margin="24"
                   loc:Loc.Text="ui.playlistEmpty"
                   Style="{StaticResource CaptionTextStyle}"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   TextAlignment="Center" />
    </Grid>
</UserControl>


