<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.MiniPlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
>

    <Grid x:Name="Root"
          Background="Transparent"
          PointerEntered="OnPointerEntered"
          PointerMoved="OnPointerMoved"
          PointerExited="OnPointerExited"
          PointerPressed="OnPointerPressed"
          PointerReleased="OnPointerReleased"
          PointerCaptureLost="OnPointerCaptureLost"
          PointerWheelChanged="OnPointerWheelChanged"
          DoubleTapped="OnRootDoubleTapped">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <!-- Generated cover tile: only visible when the file has no embedded
             album art (mpv draws real cover art as a video track behind us). -->
        <Grid x:Name="FallbackCover" Grid.Row="0">
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FF1F3A5F" />
                        <GradientStop Offset="0.55" Color="#FF2B1E45" />
                        <GradientStop Offset="1" Color="#FF101114" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <TextBlock x:Name="FallbackInitial"
                       Text="♪"
                       FontFamily="Segoe UI Symbol"
                       FontSize="72"
                       FontWeight="SemiBold"
                       Foreground="#B3FFFFFF"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="180">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Offset="0" Color="#00000000" />
                    <GradientStop Offset="1" Color="#E6000000" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Info and controls occupy the same 72 DIP strip and cross-fade
             (0.2 s, spec §10.2). -->
        <Grid x:Name="InfoPanel"
              Grid.Row="1"
              Background="#FF101114"
              Padding="16,8">
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock x:Name="TitleText"
                           Text="Wiina"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#FFFFFFFF"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1" />
                <TextBlock x:Name="ArtistText"
                           Text=""
                           FontSize="12"
                           Foreground="#B3FFFFFF"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1" />
            </StackPanel>
        </Grid>

        <Grid x:Name="ControlArea"
              Grid.Row="1"
              Background="#FF101114"
              Opacity="0"
              IsHitTestVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="24" />
                <RowDefinition Height="48" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionText"
                           Text="0:00"
                           FontSize="10"
                           Foreground="#B3FFFFFF"
                           VerticalAlignment="Center" />
                <Slider x:Name="ProgressSlider"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="1"
                        VerticalAlignment="Center"
                        ValueChanged="OnProgressChanged" />
                <TextBlock x:Name="DurationText"
                           Grid.Column="2"
                           Text="0:00"
                           FontSize="10"
                           Foreground="#B3FFFFFF"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button x:Name="MuteButton"
                        Style="{StaticResource MiniIconButtonStyle}"
                        Content="&#xE74F;"
                        Click="OnMuteClick"
                        loc:Loc.ToolTip="ui.volume"
                        loc:Loc.AutomationName="ui.volume" />
                <Button x:Name="PreviousButton"
                        Style="{StaticResource MiniIconButtonStyle}"
                        Content="&#xE892;"
                        Click="OnPreviousClick"
                        loc:Loc.ToolTip="ui.previous"
                        loc:Loc.AutomationName="ui.previous" />
                <Button x:Name="PlayPauseButton"
                        Style="{StaticResource MiniIconButtonStyle}"
                        Width="36"
                        Height="36"
                        FontSize="18"
                        Content="&#xE768;"
                        Click="OnPlayPauseClick"
                        loc:Loc.ToolTip="ui.playPauseSlash"
                        loc:Loc.AutomationName="ui.playPause" />
                <Button x:Name="NextButton"
                        Style="{StaticResource MiniIconButtonStyle}"
                        Content="&#xE893;"
                        Click="OnNextClick"
                        loc:Loc.ToolTip="ui.next"
                        loc:Loc.AutomationName="ui.next" />
                <Button x:Name="PlaylistButton"
                        Style="{StaticResource MiniIconButtonStyle}"
                        Content="&#xE8FD;"
                        Click="OnPlaylistClick"
                        loc:Loc.ToolTip="ui.playlist"
                        loc:Loc.AutomationName="ui.playlist" />
                <Button x:Name="RestoreButton"
                        Style="{StaticResource MiniIconButtonStyle}"
                        Content="&#xE73F;"
                        Click="OnRestoreClick"
                        loc:Loc.ToolTip="ui.returnMain"
                        loc:Loc.AutomationName="ui.returnMain" />
            </StackPanel>
        </Grid>

        <!-- Volume bubble: width 148, rounded, spec §10.3. -->
        <Border x:Name="VolumeBubble"
                Width="148"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,12,84"
                Padding="12,10"
                CornerRadius="18"
                Background="#E615171B"
                BorderBrush="#26FFFFFF"
                BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="BubbleMuteButton"
                            Style="{StaticResource MiniIconButtonStyle}"
                            Content="&#xE767;"
                            Click="OnMuteClick"
                            loc:Loc.ToolTip="osd.mute"
                            loc:Loc.AutomationName="osd.mute" />
                    <TextBlock x:Name="VolumeText"
                               Text="100%"
                               FontSize="11"
                               Foreground="#B3FFFFFF"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Slider x:Name="VolumeSlider"
                        Minimum="0"
                        Maximum="130"
                        ValueChanged="OnVolumeChanged" />
            </StackPanel>
        </Border>

        <!-- Playlist panel: 300 wide (spec §10.2), overlays the right edge. -->
        <Border x:Name="PlaylistPanel"
                Grid.RowSpan="2"
                Width="300"
                HorizontalAlignment="Right"
                Background="#F215171B"
                BorderBrush="#26FFFFFF"
                BorderThickness="1,0,0,0"
                Visibility="Collapsed">
            <Grid RowSpacing="8" Padding="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock loc:Loc.Text="ui.playlist" FontSize="13" FontWeight="SemiBold" />
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource MiniIconButtonStyle}"
                            Content="&#xE711;"
                            Click="OnPlaylistClick"
                            loc:Loc.AutomationName="ui.closePlaylist" />
                </Grid>
                <ListView x:Name="PlaylistList"
                          Grid.Row="1"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="OnPlaylistItemClick" />
            </Grid>
        </Border>
    </Grid>
</UserControl>




