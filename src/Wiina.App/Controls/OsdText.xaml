<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.OsdText"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
    IsHitTestVisible="False"
    IsTabStop="False">

    <Border x:Name="OsdRoot"
            Opacity="0"
            Visibility="Collapsed"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            MinWidth="120"
            MaxWidth="460"
            Padding="16,8"
            CornerRadius="12"
            Background="{ThemeResource ChromeSolidBrush}"
            BorderBrush="{ThemeResource PanelBorderBrush}"
            BorderThickness="1"
            IsHitTestVisible="False">
        <StackPanel Spacing="2">
            <Grid x:Name="TitleRow" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="OsdIcon"
                          FontFamily="{StaticResource IconFont}"
                          FontSize="16"
                          Foreground="{ThemeResource PrimaryTextBrush}"
                          VerticalAlignment="Center" />
                <TextBlock x:Name="OsdMessageText"
                           Grid.Column="1"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource PrimaryTextBrush}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Width="24"
                        Height="24"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        FontFamily="{StaticResource IconFont}"
                        FontSize="11"
                        Foreground="{ThemeResource SecondaryTextBrush}"
                        Content="&#xE711;"
                        loc:Loc.ToolTip="ui.closeEsc"
                        loc:Loc.AutomationName="ui.closeOsd"
                        Visibility="Collapsed"
                        Click="OnCloseClick" />
            </Grid>

            <TextBlock x:Name="OsdSecondaryText"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="10"
                       Foreground="{ThemeResource SecondaryTextBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <!-- A single 4 px rail keeps volume/seek OSD bars at the same
                 thickness instead of inheriting the thin system ProgressBar
                 template, which reads as a squashed line over video. -->
            <Grid x:Name="OsdProgressHost"
                  Height="4"
                  Margin="0,4,0,0"
                  Visibility="Collapsed"
                  SizeChanged="OnProgressSizeChanged">
                <Border Background="{ThemeResource OsdProgressTrackBrush}"
                        CornerRadius="2" />
                <Border x:Name="OsdProgressFill"
                        Width="0"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource AccentBrush}"
                        CornerRadius="2" />
            </Grid>

            <StackPanel x:Name="PersistentContent"
                        Spacing="8"
                        Visibility="Collapsed">
                <StackPanel x:Name="PersistentDetails" Spacing="4" />
                <ScrollViewer x:Name="PersistentBodyScroller"
                              MaxHeight="240"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="Collapsed">
                    <TextBlock x:Name="PersistentBody"
                               Style="{StaticResource BodyTextStyle}"
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />
                </ScrollViewer>
                <TextBlock loc:Loc.Text="ui.escCloseHint"
                           Style="{StaticResource CaptionTextStyle}"
                           Foreground="{ThemeResource TertiaryTextBrush}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>


