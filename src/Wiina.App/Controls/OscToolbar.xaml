<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.OscToolbar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
>

    <StackPanel Orientation="Horizontal" Spacing="1" VerticalAlignment="Center">
        <Button x:Name="PipButton"
                Style="{StaticResource OscIconButtonStyle}"
                Content="&#xE8B9;"
                Click="OnPipClick"
                loc:Loc.ToolTip="ui.pipShortcut"
                loc:Loc.AutomationName="ui.pip" />
        <Button Style="{StaticResource OscIconButtonStyle}"
                Content="&#xE8FD;"
                Command="{Binding PlaylistCommand}"
                loc:Loc.ToolTip="ui.playlistShortcut"
                loc:Loc.AutomationName="ui.playlist" />
        <Button Style="{StaticResource OscIconButtonStyle}"
                Content="&#xE713;"
                Command="{Binding SettingsCommand}"
                loc:Loc.ToolTip="ui.quickSettings"
                loc:Loc.AutomationName="ui.settings" />
        <Button x:Name="FullscreenButton"
                Style="{StaticResource OscIconButtonStyle}"
                Content="&#xE740;"
                Command="{Binding FullscreenCommand}"
                loc:Loc.AutomationName="ui.fullscreen" />
        <Button x:Name="MoreButton"
                Style="{StaticResource OscIconButtonStyle}"
                Content="&#xE712;"
                Click="OnMoreClick"
                loc:Loc.ToolTip="ui.more"
                loc:Loc.AutomationName="ui.more" />
    </StackPanel>
</UserControl>


