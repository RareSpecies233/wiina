<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.BufferIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    IsHitTestVisible="False">

    <Border x:Name="Root"
            Visibility="Collapsed"
            Padding="14,10"
            CornerRadius="10"
            Background="{ThemeResource StatusBackgroundBrush}"
            BorderBrush="{ThemeResource PanelBorderBrush}"
            BorderThickness="1">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <ProgressRing x:Name="Ring"
                          Width="22"
                          Height="22"
                          IsActive="False"
                          Foreground="{ThemeResource AccentBrush}" />
            <StackPanel Spacing="1" VerticalAlignment="Center">
                <TextBlock x:Name="LabelText"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource PrimaryTextBrush}" />
                <TextBlock x:Name="DetailText"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="11"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           Visibility="Collapsed" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
