<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.TitleBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
    xmlns:local="using:Wiina.App.Controls">

    <Grid>
        <Border x:Name="TranslucentBackground" Background="{ThemeResource TitleBarBrush}" />
        <Border x:Name="OpaqueBackground"
                Background="{ThemeResource TitleBarOpaqueBrush}"
                Visibility="Collapsed" />
        <Border BorderBrush="{ThemeResource TitleBarBorderBrush}" BorderThickness="0,0,0,1" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Spacing="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;"
                              FontFamily="{StaticResource IconFont}"
                              FontSize="16"
                              Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBlock x:Name="TitleText"
                               Text="Wiina"
                               Style="{StaticResource TitleTextStyle}"
                               Margin="4,0,0,0"
                               MaxWidth="460" />
                </StackPanel>

                <StackPanel x:Name="ButtonPanel"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="2"
                            Margin="0,0,140,0"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                    <Button x:Name="PinButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE718;"
                            Click="OnPinClick"
                            loc:Loc.ToolTip="ui.pin"
                            loc:Loc.AutomationName="ui.pin" />
                    <Button x:Name="LayoutButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE7C4;"
                            Click="OnLayoutClick"
                            loc:Loc.ToolTip="ui.layout"
                            loc:Loc.AutomationName="ui.layout" />
                    <Button x:Name="OscButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE7F4;"
                            Click="OnOscClick"
                            loc:Loc.ToolTip="ui.oscPosition"
                            loc:Loc.AutomationName="ui.oscPosition" />
                    <Button x:Name="SidebarButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE700;"
                            Click="OnSidebarClick"
                            loc:Loc.ToolTip="ui.sidebar"
                            loc:Loc.AutomationName="ui.sidebar" />
                    <Button x:Name="ThemeButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE793;"
                            Click="OnThemeClick"
                            loc:Loc.ToolTip="ui.theme"
                            loc:Loc.AutomationName="ui.theme" />
                    <Button x:Name="IconsButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE8FD;"
                            Click="OnIconsClick"
                            loc:Loc.ToolTip="ui.iconMapping"
                            loc:Loc.AutomationName="ui.iconMapping" />
                    <Button x:Name="WindowButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE8A9;"
                            Click="OnWindowClick"
                            loc:Loc.ToolTip="ui.windowSize"
                            loc:Loc.AutomationName="ui.windowSize" />
                    <Button x:Name="MoreButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE712;"
                            Click="OnMoreClick"
                            loc:Loc.ToolTip="ui.moreActions"
                            loc:Loc.AutomationName="ui.more" />
                </StackPanel>
            </Grid>

            <Border x:Name="TopOscShell"
                    Grid.Row="1"
                    Height="30"
                    Visibility="Collapsed"
                    Background="{ThemeResource SubtleBrush}">
                <Grid x:Name="TopOscRoot" Margin="10,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource OscIconButtonStyle}"
                                Content="&#xE892;"
                                Command="{Binding PreviousCommand}"
                                loc:Loc.ToolTip="ui.previous"
                                loc:Loc.AutomationName="ui.previous" />
                        <Button Style="{StaticResource OscIconButtonStyle}"
                                Content="{Binding PlayGlyph}"
                                Command="{Binding PlayPauseCommand}"
                                loc:Loc.ToolTip="ui.playPauseSlash"
                                loc:Loc.AutomationName="ui.playPause" />
                        <Button Style="{StaticResource OscIconButtonStyle}"
                                Content="&#xE893;"
                                Command="{Binding NextCommand}"
                                loc:Loc.ToolTip="ui.next"
                                loc:Loc.AutomationName="ui.next" />
                    </StackPanel>
                    <TextBlock x:Name="TopCurrentTime"
                               Grid.Column="1"
                               Text="{Binding CurrentTimeText}"
                               Width="46"
                               TextAlignment="Center"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" />
                    <local:TimelineControl x:Name="TopTimelineControl"
                                           Grid.Column="2"
                                           Margin="6,0"
                                           VerticalAlignment="Center" />
                    <TextBlock x:Name="TopDuration"
                               Grid.Column="3"
                               Text="{Binding DurationText}"
                               Width="46"
                               TextAlignment="Center"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" />
                    <local:VolumeSlider x:Name="TopVolume"
                                        Grid.Column="4"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center" />
                    <local:OscToolbar x:Name="TopToolbar"
                                      Grid.Column="5"
                                      Margin="4,0,0,0"
                                      VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>


