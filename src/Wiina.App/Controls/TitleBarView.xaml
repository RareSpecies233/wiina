<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.TitleBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
    xmlns:local="using:Wiina.App.Controls">

    <UserControl.Resources>
        <!-- Fluent's caption style is 46x32 and centres in the 40px titlebar,
             which leaves a strip above the hover fill. These local variants
             stretch the full caption row instead; the template still centres
             the glyph. -->
        <Style x:Key="TitleBarCaptionButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style x:Key="TitleBarCaptionCloseButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CaptionCloseButtonStyle}">
            <Setter Property="Height" Value="40" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="BackdropBlurHost" IsHitTestVisible="False" />
        <Border x:Name="BlurTint"
                Background="{ThemeResource TitleBarBlurTintBrush}"
                Visibility="Collapsed"
                IsHitTestVisible="False" />
        <Border x:Name="TranslucentBackground" Background="{ThemeResource ChromeSolidBrush}" />
        <Border x:Name="OpaqueBackground"
                Background="{ThemeResource TitleBarOpaqueBrush}"
                Visibility="Collapsed" />
        <Border BorderBrush="{ThemeResource TitleBarBorderBrush}" BorderThickness="0,0,0,1" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            Spacing="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                    <Image Source="ms-appx:///Assets/wiina.png"
                           Width="20"
                           Height="20"
                           Stretch="Uniform" />
                    <FontIcon x:Name="PinIndicator"
                              Glyph="&#xE718;"
                              FontSize="12"
                              Foreground="{ThemeResource AccentBrush}"
                              Margin="4,0,0,0"
                              VerticalAlignment="Center"
                              Visibility="Collapsed"
                              loc:Loc.ToolTip="ui.alwaysOnTop" />
                    <TextBlock x:Name="TitleText"
                               Text="Wiina"
                               Style="{StaticResource TitleTextStyle}"
                               Margin="4,0,0,0"
                               MaxWidth="460" />
                </StackPanel>

                <StackPanel x:Name="ButtonPanel"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="2"
                            Margin="0,0,140,0"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                    <Button x:Name="PinButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE718;"
                            Click="OnPinClick"
                            loc:Loc.ToolTip="ui.pin"
                            loc:Loc.AutomationName="ui.pin" />
                    <Button x:Name="LayoutButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE7C4;"
                            Click="OnLayoutClick"
                            loc:Loc.ToolTip="ui.layout"
                            loc:Loc.AutomationName="ui.layout" />
                    <Button x:Name="OscButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE7F4;"
                            Click="OnOscClick"
                            loc:Loc.ToolTip="ui.oscPosition"
                            loc:Loc.AutomationName="ui.oscPosition" />
                    <Button x:Name="SidebarButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE700;"
                            Click="OnSidebarClick"
                            loc:Loc.ToolTip="ui.sidebar"
                            loc:Loc.AutomationName="ui.sidebar" />
                    <Button x:Name="ThemeButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE793;"
                            Click="OnThemeClick"
                            loc:Loc.ToolTip="ui.theme"
                            loc:Loc.AutomationName="ui.theme" />
                    <Button x:Name="IconsButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE8FD;"
                            Click="OnIconsClick"
                            loc:Loc.ToolTip="ui.iconMapping"
                            loc:Loc.AutomationName="ui.iconMapping" />
                    <Button x:Name="WindowButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE8A9;"
                            Click="OnWindowClick"
                            loc:Loc.ToolTip="ui.windowSize"
                            loc:Loc.AutomationName="ui.windowSize" />
                    <Button x:Name="MoreButton"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Content="&#xE712;"
                            Click="OnMoreClick"
                            loc:Loc.ToolTip="ui.moreActions"
                            loc:Loc.AutomationName="ui.more" />
                </StackPanel>

                <!-- Custom Fluent window controls over the acrylic titlebar.
                     System caption buttons are collapsed because DWM paints an
                     opaque backing behind them in an extended titlebar. -->
                <StackPanel x:Name="WindowControlPanel"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Height="40">
                    <Button Style="{StaticResource TitleBarCaptionButtonStyle}"
                            Content="&#xE921;"
                            Click="OnMinimizeClick"
                            loc:Loc.ToolTip="ui.minimize"
                            loc:Loc.AutomationName="ui.minimize" />
                    <Button Style="{StaticResource TitleBarCaptionButtonStyle}"
                            Content="&#xE922;"
                            Click="OnMaximizeClick"
                            loc:Loc.ToolTip="ui.maximize"
                            loc:Loc.AutomationName="ui.maximize" />
                    <Button Style="{StaticResource TitleBarCaptionCloseButtonStyle}"
                            Content="&#xE8BB;"
                            Click="OnCloseClick"
                            loc:Loc.ToolTip="ui.close"
                            loc:Loc.AutomationName="ui.close" />
                </StackPanel>
            </Grid>

            <Border x:Name="TopOscShell"
                    Grid.Row="1"
                    Height="30"
                    Visibility="Collapsed"
                    BorderBrush="{ThemeResource PanelBorderBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Border x:Name="TopOscAcrylicLayer"
                            Background="{ThemeResource ChromeSolidBrush}" />
                    <Border x:Name="TopOscBlurTintLayer"
                            Background="{ThemeResource OscBlurTintBrush}"
                            Visibility="Collapsed"
                            IsHitTestVisible="False" />
                    <Grid x:Name="TopOscRoot" Margin="10,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource OscIconButtonStyle}"
                                Content="&#xE892;"
                                Command="{Binding PreviousCommand}"
                                loc:Loc.ToolTip="ui.previous"
                                loc:Loc.AutomationName="ui.previous" />
                        <Button Style="{StaticResource OscIconButtonStyle}"
                                Content="{Binding PlayGlyph}"
                                Command="{Binding PlayPauseCommand}"
                                loc:Loc.ToolTip="ui.playPauseSlash"
                                loc:Loc.AutomationName="ui.playPause" />
                        <Button Style="{StaticResource OscIconButtonStyle}"
                                Content="&#xE893;"
                                Command="{Binding NextCommand}"
                                loc:Loc.ToolTip="ui.next"
                                loc:Loc.AutomationName="ui.next" />
                    </StackPanel>
                    <TextBlock x:Name="TopCurrentTime"
                               Grid.Column="1"
                               Text="{Binding CurrentTimeText}"
                               Width="46"
                               TextAlignment="Center"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" />
                    <local:TimelineControl x:Name="TopTimelineControl"
                                           Grid.Column="2"
                                           Margin="6,0"
                                           VerticalAlignment="Center" />
                    <TextBlock x:Name="TopDuration"
                               Grid.Column="3"
                               Text="{Binding DurationText}"
                               Width="46"
                               TextAlignment="Center"
                               Style="{StaticResource CaptionTextStyle}"
                               VerticalAlignment="Center" />
                    <local:VolumeSlider x:Name="TopVolume"
                                        Grid.Column="4"
                                        Margin="6,0,0,0"
                                        VerticalAlignment="Center" />
                    <local:OscToolbar x:Name="TopToolbar"
                                      Grid.Column="5"
                                      Margin="4,0,0,0"
                                      VerticalAlignment="Center" />
                </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>


