<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.PluginsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
>

    <ScrollViewer Padding="16,8,16,16" VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource CardBorderStyle}" Padding="14">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xEA86;"
                              FontSize="16"
                              Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBlock loc:Loc.Text="ui.pluginSidebar" Style="{StaticResource SectionTitleStyle}" />
                </StackPanel>
                <TextBlock loc:Loc.Text="ui.pluginSidebarBody"
                           Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap" />
                <Button loc:Loc.Content="ui.installPluginStage9"
                        IsEnabled="False"
                        HorizontalAlignment="Left"
                        loc:Loc.ToolTip="ui.pluginStage9Hint" />
                <TextBlock loc:Loc.Text="ui.pluginDisabledReason"
                           Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>


