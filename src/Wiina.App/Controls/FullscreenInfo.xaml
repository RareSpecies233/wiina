<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.FullscreenInfo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left"
    VerticalAlignment="Bottom"
    IsHitTestVisible="False">

    <Border x:Name="Root"
            Visibility="Collapsed"
            Margin="8,0,0,8"
            Padding="10,5"
            CornerRadius="8"
            Background="{ThemeResource StatusBackgroundBrush}"
            BorderBrush="{ThemeResource PanelBorderBrush}"
            BorderThickness="1">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock x:Name="ClockText"
                       FontFamily="Consolas"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="{ThemeResource PrimaryTextBrush}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="13"
                       Foreground="{ThemeResource SecondaryTextBrush}"
                       VerticalAlignment="Center"
                       Visibility="Collapsed"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="360" />
            <StackPanel x:Name="BatteryGroup"
                        Orientation="Horizontal"
                        Spacing="4"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <FontIcon x:Name="BatteryIcon"
                          FontFamily="{StaticResource IconFont}"
                          FontSize="14"
                          Foreground="{ThemeResource SecondaryTextBrush}" />
                <TextBlock x:Name="BatteryText"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="13"
                           Foreground="{ThemeResource SecondaryTextBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
