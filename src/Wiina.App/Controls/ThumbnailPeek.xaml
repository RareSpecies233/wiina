<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.ThumbnailPeek"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    Visibility="Collapsed"
    IsHitTestVisible="False">

    <Border x:Name="Root"
            CornerRadius="4"
            BorderBrush="{ThemeResource ThumbnailBorderBrush}"
            BorderThickness="1"
            Background="#FF000000"
            Translation="0,0,8">
        <Border.Shadow>
            <ThemeShadow />
        </Border.Shadow>
        <Grid>
            <Image x:Name="PreviewImage" Stretch="UniformToFill" />
            <ProgressRing x:Name="LoadingRing"
                          Width="22"
                          Height="22"
                          IsActive="False"
                          Foreground="{ThemeResource PrimaryTextBrush}" />
            <Border x:Name="TimeBadge"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="4"
                    Padding="6,2"
                    CornerRadius="4"
                    Background="#B3000000">
                <TextBlock x:Name="TimeText"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="11"
                           Foreground="White" />
            </Border>
        </Grid>
    </Border>
</UserControl>
