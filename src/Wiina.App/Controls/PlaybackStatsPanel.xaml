<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.PlaybackStatsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="False">

    <UserControl.Resources>
        <!-- Row text brushes must come from ThemeResource so they resolve
             against this card's ActualTheme. The card is nested under
             RootGrid's element-level RequestedTheme, which can differ from the
             application theme; Application.Current.Resources[*TextBrush]
             resolved the light dictionary there and painted black text on the
             dark card (issue 6). HighContrast inherits the system colour
             mappings from Themes/Tokens.xaml. -->
        <Style x:Key="StatGroupTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="StatLabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="StatValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
        </Style>
    </UserControl.Resources>

    <!-- A plain XAML card on top of the video swapchain: no acrylic, no blur,
         no capture. Opaque by design so it stays readable over any frame and
         costs nothing while the panel is closed. -->
    <Border x:Name="Card"
            Width="380"
            MaxHeight="560"
            Background="{ThemeResource PanelBrush}"
            BorderBrush="{ThemeResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Padding="16,10,8,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="1" VerticalAlignment="Center">
                    <TextBlock loc:Loc.Text="stats.title"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource PrimaryTextBrush}" />
                    <TextBlock x:Name="SubtitleText"
                               loc:Loc.Text="stats.subtitle"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="11"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        loc:Loc.ToolTip="stats.close"
                        loc:Loc.AutomationName="stats.close"
                        Click="OnCloseClick">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Padding="16,0,16,12"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="RowsHost" Spacing="1" />
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
