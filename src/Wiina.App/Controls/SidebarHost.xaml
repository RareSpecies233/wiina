<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.SidebarHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Wiina.App.Controls"
    Width="360">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="SlideTransform" />
        </Grid.RenderTransform>

        <Border x:Name="PanelBorder"
                Background="{ThemeResource SidebarAcrylicBrush}"
                BorderBrush="{ThemeResource PanelBorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="TabStrip"
                      Grid.Row="0"
                      Margin="10,0"
                      Background="Transparent">
                    <StackPanel x:Name="TypeTabs"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <ToggleButton x:Name="SettingsTab"
                                      Style="{StaticResource SidebarTabButtonStyle}"
                                      Content="&#xE713;"
                                      Tag="Settings"
                                      Click="OnTypeTabClick"
                                      ToolTipService.ToolTip="快速设置"
                                      AutomationProperties.Name="快速设置" />
                        <ToggleButton x:Name="PlaylistTab"
                                      Style="{StaticResource SidebarTabButtonStyle}"
                                      Content="&#xE8FD;"
                                      Tag="Playlist"
                                      Click="OnTypeTabClick"
                                      ToolTipService.ToolTip="播放列表"
                                      AutomationProperties.Name="播放列表" />
                        <ToggleButton x:Name="ChaptersTab"
                                      Style="{StaticResource SidebarTabButtonStyle}"
                                      Content="&#xE81C;"
                                      Tag="Chapters"
                                      Click="OnTypeTabClick"
                                      ToolTipService.ToolTip="章节"
                                      AutomationProperties.Name="章节" />
                        <ToggleButton x:Name="PluginsTab"
                                      Style="{StaticResource SidebarTabButtonStyle}"
                                      Content="&#xEA86;"
                                      Tag="Plugins"
                                      Click="OnTypeTabClick"
                                      ToolTipService.ToolTip="插件（Stage 9）"
                                      AutomationProperties.Name="插件" />
                    </StackPanel>

                    <Button x:Name="CloseButton"
                            Style="{StaticResource OscIconButtonStyle}"
                            Content="&#xE76B;"
                            HorizontalAlignment="Right"
                            Click="OnCloseClick"
                            ToolTipService.ToolTip="关闭侧边栏"
                            AutomationProperties.Name="关闭侧边栏" />
                </Grid>

                <Grid Grid.Row="1">
                    <local:QuickSettingsView x:Name="SettingsContent" Visibility="Collapsed" />
                    <local:PlaylistView x:Name="PlaylistContent" Visibility="Collapsed" />
                    <local:ChaptersView x:Name="ChaptersContent" Visibility="Collapsed" />
                    <local:PluginsView x:Name="PluginsContent" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>

        <!-- 4 DIP inner-edge resize handle (spec §7.2 / §7.8). -->
        <Border x:Name="ResizeGrip"
                Width="4"
                HorizontalAlignment="Left"
                Background="Transparent"
                ToolTipService.ToolTip="拖动调整侧边栏宽度" />
    </Grid>
</UserControl>
