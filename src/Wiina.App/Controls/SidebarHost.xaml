<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.SidebarHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
    xmlns:local="using:Wiina.App.Controls"
    Width="360">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RenderTransform>
            <CompositeTransform x:Name="SlideTransform" />
        </Grid.RenderTransform>

        <!-- Live Gaussian blur of the frame behind the sidebar (video
             included); the acrylic border below is collapsed when it works. -->
        <Border x:Name="BackdropBlurHost" IsHitTestVisible="False" />
        <Border x:Name="SidebarBlurTintLayer"
                Background="{ThemeResource SidebarBlurTintBrush}"
                Visibility="Collapsed"
                IsHitTestVisible="False" />

        <Border x:Name="PanelBorder"
                Background="{ThemeResource SidebarAcrylicBrush}"
                BorderBrush="{ThemeResource PanelBorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="52" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="TabStrip"
                      Grid.Row="0"
                      Margin="10,0"
                      Background="Transparent">
                    <StackPanel x:Name="TypeTabs"
                                Orientation="Horizontal"
                                Spacing="2"
                                VerticalAlignment="Center">
                        <ToggleButton x:Name="SettingsTab"
                                      Style="{StaticResource SidebarTabButtonStyle}"
                                      Content="&#xE713;"
                                      Tag="Settings"
                                      Click="OnTypeTabClick"
                                      loc:Loc.ToolTip="ui.quickSettings"
                                      loc:Loc.AutomationName="ui.quickSettings" />
                        <ToggleButton x:Name="PlaylistTab"
                                      Style="{StaticResource SidebarTabButtonStyle}"
                                      Content="&#xE8FD;"
                                      Tag="Playlist"
                                      Click="OnTypeTabClick"
                                      loc:Loc.ToolTip="ui.playlist"
                                      loc:Loc.AutomationName="ui.playlist" />
                        <ToggleButton x:Name="ChaptersTab"
                                      Style="{StaticResource SidebarTabButtonStyle}"
                                      Content="&#xE81C;"
                                      Tag="Chapters"
                                      Click="OnTypeTabClick"
                                      loc:Loc.ToolTip="ui.chapters"
                                      loc:Loc.AutomationName="ui.chapters" />
                        <ToggleButton x:Name="PluginsTab"
                                      Style="{StaticResource SidebarTabButtonStyle}"
                                      Content="&#xEA86;"
                                      Tag="Plugins"
                                      Click="OnTypeTabClick"
                                      loc:Loc.ToolTip="ui.pluginsStage9"
                                      loc:Loc.AutomationName="ui.plugins" />
                    </StackPanel>

                    <Button x:Name="CloseButton"
                            Style="{StaticResource OscIconButtonStyle}"
                            Content="&#xE76B;"
                            HorizontalAlignment="Right"
                            Click="OnCloseClick"
                            loc:Loc.ToolTip="ui.closeSidebar"
                            loc:Loc.AutomationName="ui.closeSidebar" />
                </Grid>

                <Grid Grid.Row="1">
                    <local:QuickSettingsView x:Name="SettingsContent" Visibility="Collapsed" />
                    <local:PlaylistView x:Name="PlaylistContent" Visibility="Collapsed" />
                    <local:ChaptersView x:Name="ChaptersContent" Visibility="Collapsed" />
                    <local:PluginsView x:Name="PluginsContent" Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>

        <!-- 4 DIP inner-edge resize handle (spec §7.2 / §7.8). -->
        <Border x:Name="ResizeGrip"
                Width="4"
                HorizontalAlignment="Left"
                Background="Transparent"
                loc:Loc.ToolTip="ui.resizeSidebar" />
    </Grid>
</UserControl>


