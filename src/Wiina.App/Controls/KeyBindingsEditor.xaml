<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.KeyBindingsEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:loc="using:Wiina.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsTabStop="True"
    UseSystemFocusVisuals="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Profile row -->
        <Grid Margin="0,0,0,12" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ProfileLabel"
                VerticalAlignment="Center"
                FontSize="12"
                FontWeight="SemiBold" />
            <ComboBox
                x:Name="ProfileBox"
                Grid.Column="1"
                MinWidth="140"
                SelectionChanged="OnProfileChanged" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                <Button Content="新建" Click="OnNewProfileClick" Style="{StaticResource SettingsEditorButtonStyle}" />
                <Button Content="重命名" Click="OnRenameProfileClick" Style="{StaticResource SettingsEditorButtonStyle}" />
                <Button loc:Loc.Content="ui.delete" Click="OnDeleteProfileClick" Style="{StaticResource SettingsEditorButtonStyle}" />
            </StackPanel>
            <TextBlock x:Name="ProfileHintLabel"
                Grid.Column="3"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                FontSize="11"
                Opacity="0.62"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Action list -->
            <Border
                Background="{ThemeResource SettingsRailBrush}"
                BorderBrush="{ThemeResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ScrollViewer
                    Padding="6"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ActionList" Spacing="2" />
                </ScrollViewer>
            </Border>

            <!-- Selection / recording panel -->
            <Border
                Grid.Column="1"
                Padding="18,16"
                Background="{ThemeResource DialogSurfaceBrush}"
                BorderBrush="{ThemeResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        x:Name="ActionName"
                        FontSize="18"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="ActionCategory"
                        Grid.Row="1"
                        Margin="0,3,0,0"
                        FontSize="11"
                        Opacity="0.6" />

                    <Border
                        Grid.Row="2"
                        Margin="0,16,0,0"
                        Padding="14,12"
                        Background="{ThemeResource KeyChordChipBrush}"
                        BorderBrush="{ThemeResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="SectionLabel"
                                FontSize="10"
                                Opacity="0.6" />
                            <TextBlock
                                x:Name="ChordText"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="18"
                                Foreground="{ThemeResource AccentBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,16,0,0" Spacing="8">
                        <TextBlock
                            x:Name="HintText"
                            FontSize="12"
                            Opacity="0.75"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="StatusText"
                            FontSize="12"
                            Foreground="{ThemeResource AccentBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button
                                x:Name="RecordButton"
                                MinHeight="30"
                                Padding="12,4"
                                Click="OnRecordClick"
                                Style="{StaticResource SettingsEditorButtonStyle}"
                                loc:Loc.Content="keybindings.record" />
                            <Button
                                x:Name="CancelButton"
                                MinHeight="30"
                                Padding="12,4"
                                Click="OnCancelClick"
                                Visibility="Collapsed"
                                Style="{StaticResource SettingsEditorButtonStyle}"
                                loc:Loc.Content="keybindings.cancelRecording" />
                            <Button
                                MinHeight="30"
                                Padding="12,4"
                                Click="OnClearClick"
                                Style="{StaticResource SettingsEditorButtonStyle}"
                                loc:Loc.Content="keybindings.clear" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button
                                MinHeight="30"
                                Padding="12,4"
                                Click="OnResetOneClick"
                                Style="{StaticResource SettingsEditorButtonStyle}"
                                loc:Loc.Content="keybindings.resetOne" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer actions -->
        <Grid Grid.Row="2" Margin="0,12,0,0" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button
                    MinHeight="30"
                    Padding="12,4"
                    Click="OnImportClick"
                    Style="{StaticResource SettingsEditorButtonStyle}"
                    loc:Loc.Content="keybindings.import" />
                <Button
                    MinHeight="30"
                    Padding="12,4"
                    Click="OnExportClick"
                    Style="{StaticResource SettingsEditorButtonStyle}"
                    loc:Loc.Content="keybindings.export" />
            </StackPanel>
            <Button
                Grid.Column="1"
                MinHeight="30"
                Padding="12,4"
                Click="OnResetAllClick"
                Style="{StaticResource SettingsEditorButtonStyle}"
                loc:Loc.Content="keybindings.resetAll" />
        </Grid>
    </Grid>
</UserControl>
