<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.OscBottomView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
    xmlns:local="using:Wiina.App.Controls">

    <Border Background="{ThemeResource PanelBrush}"
            BorderBrush="{ThemeResource PanelBorderBrush}"
            BorderThickness="0,1,0,0"
            Height="64">
        <Grid Margin="16,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="TransportGroup"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource OscIconButtonStyle}"
                        Content="&#xE892;"
                        Command="{Binding PreviousCommand}"
                        loc:Loc.ToolTip="ui.previous"
                        loc:Loc.AutomationName="ui.previous" />
                <Button Style="{StaticResource OscIconButtonStyle}"
                        Content="{Binding PlayGlyph}"
                        Command="{Binding PlayPauseCommand}"
                        FontSize="18"
                        loc:Loc.ToolTip="ui.playPauseSlash"
                        loc:Loc.AutomationName="ui.playPause" />
                <Button Style="{StaticResource OscIconButtonStyle}"
                        Content="&#xE893;"
                        Command="{Binding NextCommand}"
                        loc:Loc.ToolTip="ui.next"
                        loc:Loc.AutomationName="ui.next" />
                <TextBlock x:Name="CurrentTimeLabel"
                           Text="{Binding CurrentTimeText}"
                           Width="46"
                           TextAlignment="Center"
                           Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>

            <local:TimelineControl x:Name="InnerTimeline"
                                   Grid.Column="1"
                                   Margin="12,0" />

            <TextBlock x:Name="DurationLabel"
                       Grid.Column="2"
                       Text="{Binding DurationText}"
                       Width="46"
                       TextAlignment="Center"
                       Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center" />

            <local:VolumeSlider x:Name="VolumeGroup"
                                Grid.Column="3"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center" />

            <local:OscToolbar x:Name="ToolbarGroup"
                              Grid.Column="4"
                              Margin="6,0,0,0"
                              VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>


