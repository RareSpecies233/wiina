<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.OscBottomView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Background="{ThemeResource PanelBrush}"
            BorderBrush="{ThemeResource PanelBorderBrush}"
            BorderThickness="0,1,0,0"
            Height="64">
        <Grid Margin="16,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Style="{StaticResource OscIconButtonStyle}" Content="&#xE892;" />
                <Button Style="{StaticResource OscIconButtonStyle}" Content="&#xE768;" FontSize="18" />
                <Button Style="{StaticResource OscIconButtonStyle}" Content="&#xE893;" />
                <TextBlock Text="00:00" Style="{StaticResource CaptionTextStyle}" Margin="6,0,0,0" />
            </StackPanel>

            <ProgressBar Grid.Column="1"
                         Height="4"
                         Minimum="0"
                         Maximum="100"
                         Value="25"
                         Margin="12,0"
                         VerticalAlignment="Center" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Text="00:00" Style="{StaticResource CaptionTextStyle}" Margin="0,0,6,0" />
                <Button Style="{StaticResource OscIconButtonStyle}" Content="&#xE767;" />
                <Slider Width="70" Value="70" VerticalAlignment="Center" />
                <Button Style="{StaticResource OscIconButtonStyle}" Content="&#xE8D8;" ToolTipService.ToolTip="字幕" />
                <Button Style="{StaticResource OscIconButtonStyle}" Content="&#xE8FD;" ToolTipService.ToolTip="播放列表" />
                <Button Style="{StaticResource OscIconButtonStyle}" Content="&#xE713;" ToolTipService.ToolTip="设置" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
