<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.VolumeSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
>

    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Style="{StaticResource OscIconButtonStyle}"
                Content="{Binding VolumeGlyph}"
                Command="{Binding MuteCommand}"
                loc:Loc.ToolTip="ui.muteShortcut"
                loc:Loc.AutomationName="osd.mute" />
        <!-- Native WinUI 3 slider. 101 DIP with 8 DIP padding leaves an 85 DIP
             rail (90% of the previous 94 DIP) and keeps the native Fluent thumb
             fully inside the control at both 0% and 100%. -->
        <Slider x:Name="VolumeInput"
                Width="101"
                Height="32"
                Minimum="0"
                Maximum="100"
                StepFrequency="1"
                Value="{Binding VolumeUi, Mode=TwoWay}"
                Padding="8,0"
                IsThumbToolTipEnabled="False"
                VerticalAlignment="Center"
                ToolTipService.ToolTip="{Binding VolumeText}"
                loc:Loc.AutomationName="ui.volume"
                PointerWheelChanged="OnSliderWheelChanged" />
    </StackPanel>
</UserControl>
