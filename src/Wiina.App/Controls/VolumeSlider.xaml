<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.VolumeSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Style="{StaticResource OscIconButtonStyle}"
                Content="{Binding VolumeGlyph}"
                Command="{Binding MuteCommand}"
                ToolTipService.ToolTip="静音 (Ctrl+M)"
                AutomationProperties.Name="静音" />
        <Grid x:Name="SliderHost"
              Width="70"
              Height="28"
              VerticalAlignment="Center"
              ToolTipService.ToolTip="{Binding VolumeText}">
            <Slider x:Name="VolumeInput"
                    Minimum="0"
                    Maximum="130"
                    StepFrequency="1"
                    Value="{Binding Volume, Mode=TwoWay}"
                    IsThumbToolTipEnabled="False"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="音量" />
            <!-- 2 px notch at 100% so over-amplification is visible. -->
            <Border x:Name="UnityNotch"
                    Width="2"
                    Height="12"
                    CornerRadius="1"
                    Background="{ThemeResource SecondaryTextBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False" />
        </Grid>
    </StackPanel>
</UserControl>
