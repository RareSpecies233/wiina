<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.VolumeSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
>

    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Style="{StaticResource OscIconButtonStyle}"
                Content="{Binding VolumeGlyph}"
                Command="{Binding MuteCommand}"
                loc:Loc.ToolTip="ui.muteShortcut"
                loc:Loc.AutomationName="osd.mute" />
        <Grid x:Name="SliderHost"
              Width="70"
              Height="28"
              VerticalAlignment="Center"
              ToolTipService.ToolTip="{Binding VolumeText}">
            <Slider x:Name="VolumeInput"
                    Minimum="0"
                    Maximum="100"
                    StepFrequency="1"
                    Value="{Binding VolumeUi, Mode=TwoWay}"
                    IsThumbToolTipEnabled="False"
                    VerticalAlignment="Center"
                    PointerWheelChanged="OnSliderWheelChanged"
                    loc:Loc.AutomationName="ui.volume" />
            <!-- 2 px notch at the 100% stop; over-amplification pins the thumb here. -->
            <Border x:Name="UnityNotch"
                    Width="2"
                    Height="12"
                    CornerRadius="1"
                    Background="{ThemeResource SecondaryTextBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False" />
        </Grid>
    </StackPanel>
</UserControl>


