<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.VolumeSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
>

    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <Button Style="{StaticResource OscIconButtonStyle}"
                Content="{Binding VolumeGlyph}"
                Command="{Binding MuteCommand}"
                loc:Loc.ToolTip="ui.muteShortcut"
                loc:Loc.AutomationName="osd.mute" />
        <!-- 12 px inset each side keeps the 20 px thumb inside the host at 0%
             and 100% (WinUI's default template otherwise clips half of it at
             the maximum on high-DPI displays). -->
        <Grid x:Name="SliderHost"
              Width="94"
              Height="28"
              VerticalAlignment="Center"
              ToolTipService.ToolTip="{Binding VolumeText}">
            <Slider x:Name="VolumeInput"
                    Minimum="0"
                    Maximum="100"
                    StepFrequency="1"
                    Value="{Binding VolumeUi, Mode=TwoWay}"
                    IsThumbToolTipEnabled="False"
                    Margin="12,0"
                    VerticalAlignment="Center"
                    PointerWheelChanged="OnSliderWheelChanged"
                    loc:Loc.AutomationName="ui.volume" />
        </Grid>
    </StackPanel>
</UserControl>


