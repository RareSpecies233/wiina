<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.QuickSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
    xmlns:controls="using:Wiina.App.Controls">

    <UserControl.Resources>
        <!-- Boxed Fluent tab for the quick settings page tabs. This mirrors
             the native WinUI selection chrome (rounded control fill + outline)
             instead of painting a custom underline that only mimics TabView. -->
        <Style x:Key="QuickPageTabStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="TabRoot" Background="Transparent">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="TabBox.Background" Value="{ThemeResource SidebarTabHoverBrush}" />
                                            <Setter Target="TabContent.Foreground" Value="{ThemeResource PrimaryTextBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="TabContent.Opacity" Value="0.7" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="TabContent.Opacity" Value="0.4" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="TabBox.Background" Value="{ThemeResource SidebarTabSelectedBrush}" />
                                            <Setter Target="TabBox.BorderBrush" Value="{ThemeResource PanelBorderBrush}" />
                                            <Setter Target="TabContent.Foreground" Value="{ThemeResource AccentBrush}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Indeterminate" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="TabBox"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <ContentPresenter x:Name="TabContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  FontFamily="{TemplateBinding FontFamily}"
                                                  FontSize="{TemplateBinding FontSize}"
                                                  Foreground="{TemplateBinding Foreground}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal"
                    Spacing="4"
                    Margin="12,6,12,4">
            <ToggleButton x:Name="LayoutPageButton"
                          Style="{StaticResource QuickPageTabStyle}"
                          loc:Loc.Content="ui.layout"
                          Tag="Layout"
                          Click="OnPageButtonClick"
                          IsChecked="True" />
            <ToggleButton x:Name="VideoPageButton"
                          Style="{StaticResource QuickPageTabStyle}"
                          loc:Loc.Content="osd.track.video"
                          Tag="Video"
                          Click="OnPageButtonClick" />
            <ToggleButton x:Name="AudioPageButton"
                          Style="{StaticResource QuickPageTabStyle}"
                          loc:Loc.Content="osd.track.audio"
                          Tag="Audio"
                          Click="OnPageButtonClick" />
            <ToggleButton x:Name="SubtitlePageButton"
                          Style="{StaticResource QuickPageTabStyle}"
                          loc:Loc.Content="osd.track.subtitle"
                          Tag="Subtitles"
                          Click="OnPageButtonClick" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Padding="16,4,16,16"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <!-- ================================================== Layout -->
                <StackPanel x:Name="LayoutPage" Spacing="14">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE790;" FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock loc:Loc.Text="ui.appearance" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <Button Style="{StaticResource CardHeaderButtonStyle}"
                                        Content="&#xE72C;"
                                        HorizontalAlignment="Right"
                                        Tag="appearance"
                                        Click="OnResetClick"
                                        loc:Loc.ToolTip="ui.resetAppearance" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.theme" Style="{StaticResource BodyTextStyle}" />
                                <ComboBox x:Name="ThemeBox"
                                          Grid.Column="1"
                                          Width="150"
                                          SelectionChanged="OnComboChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.enableAnimations" Style="{StaticResource BodyTextStyle}" />
                                <ToggleSwitch x:Name="AnimationsSwitch"
                                              Grid.Column="1"
                                              MinWidth="0"
                                              loc:Loc.OnContent="ui.on"
                                              loc:Loc.OffContent="ui.off"
                                              Toggled="OnToggleChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE737;" FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock loc:Loc.Text="ui.window" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <Button Style="{StaticResource CardHeaderButtonStyle}"
                                        Content="&#xE72C;"
                                        HorizontalAlignment="Right"
                                        Tag="window"
                                        Click="OnResetClick"
                                        loc:Loc.ToolTip="ui.resetWindow" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.sidebarLayout" Style="{StaticResource BodyTextStyle}" />
                                <ComboBox x:Name="LayoutBox"
                                          Grid.Column="1"
                                          Width="170"
                                          SelectionChanged="OnComboChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.alwaysOnTop" Style="{StaticResource BodyTextStyle}" />
                                <ToggleSwitch x:Name="AlwaysOnTopSwitch"
                                              Grid.Column="1"
                                              MinWidth="0"
                                              Toggled="OnToggleChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.lockAspect" Style="{StaticResource BodyTextStyle}" />
                                <ToggleSwitch x:Name="LockAspectSwitch"
                                              Grid.Column="1"
                                              MinWidth="0"
                                              Toggled="OnToggleChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8B9;" FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock Text="OSC" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <Button Style="{StaticResource CardHeaderButtonStyle}"
                                        Content="&#xE72C;"
                                        HorizontalAlignment="Right"
                                        Tag="osc"
                                        Click="OnResetClick"
                                        loc:Loc.ToolTip="ui.resetOsc" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.position" Style="{StaticResource BodyTextStyle}" />
                                <ComboBox x:Name="OscPositionBox"
                                          Grid.Column="1"
                                          Width="150"
                                          SelectionChanged="OnComboChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.autohide25" Style="{StaticResource BodyTextStyle}" />
                                <ToggleSwitch x:Name="OscAutoHideSwitch"
                                              Grid.Column="1"
                                              MinWidth="0"
                                              Toggled="OnToggleChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock loc:Loc.Text="ui.osdPreview" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <Button Style="{StaticResource CardHeaderButtonStyle}"
                                        Content="&#xE72C;"
                                        HorizontalAlignment="Right"
                                        Tag="osd"
                                        Click="OnResetClick"
                                        loc:Loc.ToolTip="ui.resetOsd" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.enableOsd" Style="{StaticResource BodyTextStyle}" />
                                <ToggleSwitch x:Name="OsdEnabledSwitch"
                                              Grid.Column="1"
                                              MinWidth="0"
                                              Toggled="OnToggleChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.position" Style="{StaticResource BodyTextStyle}" />
                                <ComboBox x:Name="OsdPositionBox"
                                          Grid.Column="1"
                                          Width="150"
                                          SelectionChanged="OnComboChanged" />
                            </Grid>

                            <StackPanel Spacing="2">
                                <Grid>
                                    <TextBlock loc:Loc.Text="ui.fontSize" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock x:Name="OsdSizeText"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </Grid>
                                <Slider x:Name="OsdSizeSlider"
                                        StepFrequency="5"
                                        ValueChanged="OnSliderValueChanged" />
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.holdSeconds" Style="{StaticResource BodyTextStyle}" />
                                <NumberBox x:Name="OsdDurationBox"
                                           Grid.Column="1"
                                           Width="110"
                                           Minimum="0.1"
                                           Maximum="30"
                                           SmallChange="0.1"
                                           SpinButtonPlacementMode="Compact"
                                           ValueChanged="OnNumberBoxChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.persistentOsd" Style="{StaticResource BodyTextStyle}" />
                                <ToggleSwitch x:Name="OsdPersistentSwitch"
                                              Grid.Column="1"
                                              MinWidth="0"
                                              Toggled="OnToggleChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.fullscreenClock" Style="{StaticResource BodyTextStyle}" />
                                <ToggleSwitch x:Name="FullscreenClockSwitch"
                                              Grid.Column="1"
                                              MinWidth="0"
                                              Toggled="OnToggleChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.fullscreenBattery" Style="{StaticResource BodyTextStyle}" />
                                <ToggleSwitch x:Name="FullscreenBatterySwitch"
                                              Grid.Column="1"
                                              MinWidth="0"
                                              Toggled="OnToggleChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.fullscreenTitle" Style="{StaticResource BodyTextStyle}" />
                                <ToggleSwitch x:Name="FullscreenTitleSwitch"
                                              Grid.Column="1"
                                              MinWidth="0"
                                              Toggled="OnToggleChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.timelineThumbs" Style="{StaticResource BodyTextStyle}" />
                                <ToggleSwitch x:Name="ThumbnailPreviewSwitch"
                                              Grid.Column="1"
                                              MinWidth="0"
                                              Toggled="OnToggleChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE700;" FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock loc:Loc.Text="ui.sidebar" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <Button Style="{StaticResource CardHeaderButtonStyle}"
                                        Content="&#xE72C;"
                                        HorizontalAlignment="Right"
                                        Tag="sidebar"
                                        Click="OnResetClick"
                                        loc:Loc.ToolTip="ui.resetSidebar" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.defaultSide" Style="{StaticResource BodyTextStyle}" />
                                <ComboBox x:Name="SidebarSideBox"
                                          Grid.Column="1"
                                          Width="150"
                                          SelectionChanged="OnComboChanged" />
                            </Grid>

                            <StackPanel Spacing="2">
                                <Grid>
                                    <TextBlock loc:Loc.Text="ui.width" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock x:Name="SidebarWidthText"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </Grid>
                                <Slider x:Name="SidebarWidthSlider"
                                        StepFrequency="1"
                                        ValueChanged="OnSliderValueChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- =================================================== Video -->
                <StackPanel x:Name="VideoPage" Spacing="14" Visibility="Collapsed">
                    <TextBlock x:Name="VideoHint"
                               loc:Loc.Text="ui.videoUnavailableHint"
                               Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE714;" FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock loc:Loc.Text="ui.videoTrack" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <Button Style="{StaticResource CardHeaderButtonStyle}"
                                        Content="&#xE72C;"
                                        HorizontalAlignment="Right"
                                        Tag="video-track"
                                        Click="OnResetClick"
                                        loc:Loc.ToolTip="ui.resetVideoTrack" />
                            </Grid>
                            <ComboBox x:Name="VideoTrackBox"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnComboChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7C4;" FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock loc:Loc.Text="ui.picture" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <Button Style="{StaticResource CardHeaderButtonStyle}"
                                        Content="&#xE72C;"
                                        HorizontalAlignment="Right"
                                        Tag="video-picture"
                                        Click="OnResetClick"
                                        loc:Loc.ToolTip="ui.resetPicture" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.aspectRatio" Style="{StaticResource BodyTextStyle}" />
                                <ComboBox x:Name="AspectBox"
                                          Grid.Column="1"
                                          Width="140"
                                          SelectionChanged="OnComboChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.crop" Style="{StaticResource BodyTextStyle}" />
                                <ComboBox x:Name="CropBox"
                                          Grid.Column="1"
                                          Width="140"
                                          SelectionChanged="OnComboChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.rotate" Style="{StaticResource BodyTextStyle}" />
                                <ComboBox x:Name="RotationBox"
                                          Grid.Column="1"
                                          Width="140"
                                          SelectionChanged="OnComboChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.flipH" Style="{StaticResource BodyTextStyle}" />
                                <ToggleSwitch x:Name="FlipHorizontalSwitch"
                                              Grid.Column="1"
                                              MinWidth="0"
                                              Toggled="OnToggleChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.flipV" Style="{StaticResource BodyTextStyle}" />
                                <ToggleSwitch x:Name="FlipVerticalSwitch"
                                              Grid.Column="1"
                                              MinWidth="0"
                                              Toggled="OnToggleChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.deinterlace" Style="{StaticResource BodyTextStyle}" />
                                <ToggleSwitch x:Name="DeinterlaceSwitch"
                                              Grid.Column="1"
                                              MinWidth="0"
                                              Toggled="OnToggleChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.hwdec" Style="{StaticResource BodyTextStyle}" />
                                <ToggleSwitch x:Name="HardwareDecodeSwitch"
                                              Grid.Column="1"
                                              MinWidth="0"
                                              Toggled="OnToggleChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71E;" FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock loc:Loc.Text="ui.zoomPan" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <Button Style="{StaticResource CardHeaderButtonStyle}"
                                        Content="&#xE72C;"
                                        HorizontalAlignment="Right"
                                        Tag="video-zoom"
                                        Click="OnResetClick"
                                        loc:Loc.ToolTip="ui.resetZoomPan" />
                            </Grid>

                            <StackPanel Spacing="2">
                                <Grid>
                                    <TextBlock loc:Loc.Text="ui.zoom" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock x:Name="ZoomValueText"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </Grid>
                                <Slider x:Name="ZoomSlider"
                                        Minimum="-1"
                                        Maximum="1"
                                        StepFrequency="0.05"
                                        ValueChanged="OnSliderValueChanged" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <Grid>
                                    <TextBlock loc:Loc.Text="ui.panX" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock x:Name="PanXValueText"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </Grid>
                                <Slider x:Name="PanXSlider"
                                        Minimum="-1"
                                        Maximum="1"
                                        StepFrequency="0.01"
                                        ValueChanged="OnSliderValueChanged" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <Grid>
                                    <TextBlock loc:Loc.Text="ui.panY" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock x:Name="PanYValueText"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </Grid>
                                <Slider x:Name="PanYSlider"
                                        Minimum="-1"
                                        Maximum="1"
                                        StepFrequency="0.01"
                                        ValueChanged="OnSliderValueChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- =================================================== Audio -->
                <StackPanel x:Name="AudioPage" Spacing="14" Visibility="Collapsed">
                    <TextBlock x:Name="AudioHint"
                               loc:Loc.Text="ui.audioUnavailableHint"
                               Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D6;" FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock loc:Loc.Text="ui.audioTrack" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <Button Style="{StaticResource CardHeaderButtonStyle}"
                                        Content="&#xE72C;"
                                        HorizontalAlignment="Right"
                                        Tag="audio-track"
                                        Click="OnResetClick"
                                        loc:Loc.ToolTip="ui.resetAudioTrack" />
                            </Grid>
                            <ComboBox x:Name="AudioTrackBox"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnComboChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE767;" FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock loc:Loc.Text="ui.volume" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <Button Style="{StaticResource CardHeaderButtonStyle}"
                                        Content="&#xE72C;"
                                        HorizontalAlignment="Right"
                                        Tag="audio-volume"
                                        Click="OnResetClick"
                                        loc:Loc.ToolTip="ui.resetVolume" />
                            </Grid>

                            <StackPanel Spacing="2">
                                <Grid>
                                    <TextBlock loc:Loc.Text="ui.volume" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock x:Name="VolumeValueText"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </Grid>
                                <Slider x:Name="VolumeSlider"
                                        Minimum="0"
                                        Maximum="100"
                                        StepFrequency="1"
                                        ValueChanged="OnSliderValueChanged" />
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.maxVolume" Style="{StaticResource BodyTextStyle}" />
                                <NumberBox x:Name="MaxVolumeBox"
                                           Grid.Column="1"
                                           Width="110"
                                           Minimum="100"
                                           Maximum="200"
                                           SmallChange="5"
                                           ValueChanged="OnNumberBoxChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="osd.mute" Style="{StaticResource BodyTextStyle}" />
                                <ToggleSwitch x:Name="MuteSwitch"
                                              Grid.Column="1"
                                              MinWidth="0"
                                              Toggled="OnToggleChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE916;" FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock loc:Loc.Text="ui.audioDelay" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <Button Style="{StaticResource CardHeaderButtonStyle}"
                                        Content="&#xE72C;"
                                        HorizontalAlignment="Right"
                                        Tag="audio-delay"
                                        Click="OnResetClick"
                                        loc:Loc.ToolTip="ui.resetAudioDelay" />
                            </Grid>
                            <Grid>
                                <TextBlock loc:Loc.Text="ui.delaySeconds" Style="{StaticResource BodyTextStyle}" />
                                <TextBlock x:Name="AudioDelayText"
                                           HorizontalAlignment="Right"
                                           Style="{StaticResource CaptionTextStyle}" />
                            </Grid>
                            <Slider x:Name="AudioDelaySlider"
                                    Minimum="-10"
                                    Maximum="10"
                                    StepFrequency="0.1"
                                    ValueChanged="OnSliderValueChanged" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9E9;" FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock loc:Loc.Text="ui.equalizer" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="EqualizerSwitch"
                                              HorizontalAlignment="Right"
                                              MinWidth="0"
                                              Toggled="OnToggleChanged" />
                            </Grid>
                            <ComboBox x:Name="EqualizerPresetBox"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnComboChanged" />
                            <controls:EqualizerView x:Name="EqView"
                                                    GainsChanged="OnEqualizerGainsChanged" />
                            <Grid>
                                <TextBlock Text="31 Hz – 16 kHz · −12…+12 dB"
                                           Style="{StaticResource CaptionTextStyle}" />
                                <Button Style="{StaticResource CardHeaderButtonStyle}"
                                        Content="&#xE72C;"
                                        HorizontalAlignment="Right"
                                        Tag="audio-equalizer"
                                        Click="OnResetClick"
                                        loc:Loc.ToolTip="ui.resetEq" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7F5;" FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock loc:Loc.Text="ui.outputDevice" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <Button Style="{StaticResource CardHeaderButtonStyle}"
                                        Content="&#xE72C;"
                                        HorizontalAlignment="Right"
                                        Tag="audio-device"
                                        Click="OnResetClick"
                                        loc:Loc.ToolTip="ui.resetAudioDevice" />
                            </Grid>
                            <ComboBox x:Name="AudioDeviceBox"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="OnComboChanged" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AudioDeviceHint"
                                           loc:Loc.Text="ui.deviceListFromMpv"
                                           Style="{StaticResource CaptionTextStyle}"
                                           TextWrapping="Wrap" />
                                <Button x:Name="RefreshDevicesButton"
                                        Grid.Column="1"
                                        Style="{StaticResource CardHeaderButtonStyle}"
                                        Content="&#xE72C;"
                                        Click="OnRefreshDevicesClick"
                                        loc:Loc.ToolTip="ui.refreshDevices" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ================================================= Subtitles -->
                <StackPanel x:Name="SubtitlesPage" Spacing="14" Visibility="Collapsed">
                    <TextBlock x:Name="SubtitleHint"
                               loc:Loc.Text="ui.subtitleUnavailableHint"
                               Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D8;" FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock loc:Loc.Text="ui.subtitleTrack" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <Button Style="{StaticResource CardHeaderButtonStyle}"
                                        Content="&#xE72C;"
                                        HorizontalAlignment="Right"
                                        Tag="subtitle-track"
                                        Click="OnResetClick"
                                        loc:Loc.ToolTip="ui.resetSubtitleTrack" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.primarySubtitles" Style="{StaticResource BodyTextStyle}" />
                                <ComboBox x:Name="SubtitleTrackBox"
                                          Grid.Column="1"
                                          Width="180"
                                          SelectionChanged="OnComboChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.secondarySubtitles" Style="{StaticResource BodyTextStyle}" />
                                <ComboBox x:Name="SecondarySubtitleBox"
                                          Grid.Column="1"
                                          Width="180"
                                          SelectionChanged="OnComboChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.showSubtitles" Style="{StaticResource BodyTextStyle}" />
                                <ToggleSwitch x:Name="SubtitleVisibleSwitch"
                                              Grid.Column="1"
                                              MinWidth="0"
                                              Toggled="OnToggleChanged" />
                            </Grid>

                            <Button x:Name="LoadSubtitleButton"
                                    HorizontalAlignment="Stretch"
                                    Click="OnLoadSubtitleClick">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                                    <TextBlock loc:Loc.Text="ui.loadSubtitle" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE916;" FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock loc:Loc.Text="ui.positionTiming" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <Button Style="{StaticResource CardHeaderButtonStyle}"
                                        Content="&#xE72C;"
                                        HorizontalAlignment="Right"
                                        Tag="subtitle-timing"
                                        Click="OnResetClick"
                                        loc:Loc.ToolTip="ui.resetSubtitlePosition" />
                            </Grid>

                            <StackPanel Spacing="2">
                                <Grid>
                                    <TextBlock loc:Loc.Text="ui.delaySeconds" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock x:Name="SubtitleDelayText"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </Grid>
                                <Slider x:Name="SubtitleDelaySlider"
                                        Minimum="-30"
                                        Maximum="30"
                                        StepFrequency="0.1"
                                        ValueChanged="OnSliderValueChanged" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <Grid>
                                    <TextBlock loc:Loc.Text="ui.positionY" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock x:Name="SubtitlePositionText"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </Grid>
                                <Slider x:Name="SubtitlePositionSlider"
                                        Minimum="0"
                                        Maximum="150"
                                        StepFrequency="1"
                                        ValueChanged="OnSliderValueChanged" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <Grid>
                                    <TextBlock loc:Loc.Text="ui.zoom" Style="{StaticResource BodyTextStyle}" />
                                    <TextBlock x:Name="SubtitleScaleText"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </Grid>
                                <Slider x:Name="SubtitleScaleSlider"
                                        Minimum="0.5"
                                        Maximum="2"
                                        StepFrequency="0.05"
                                        ValueChanged="OnSliderValueChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8D2;" FontSize="14" Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock loc:Loc.Text="ui.style" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <Button Style="{StaticResource CardHeaderButtonStyle}"
                                        Content="&#xE72C;"
                                        HorizontalAlignment="Right"
                                        Tag="subtitle-style"
                                        Click="OnResetClick"
                                        loc:Loc.ToolTip="ui.resetSubtitleStyle" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.fontSize" Style="{StaticResource BodyTextStyle}" />
                                <NumberBox x:Name="SubtitleFontSizeBox"
                                           Grid.Column="1"
                                           Width="110"
                                           Minimum="8"
                                           Maximum="120"
                                           SmallChange="2"
                                           ValueChanged="OnNumberBoxChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.color" Style="{StaticResource BodyTextStyle}" />
                                <ComboBox x:Name="SubtitleColorBox"
                                          Grid.Column="1"
                                          Width="140"
                                          SelectionChanged="OnComboChanged" />
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock loc:Loc.Text="ui.border" Style="{StaticResource BodyTextStyle}" />
                                <NumberBox x:Name="SubtitleBorderBox"
                                           Grid.Column="1"
                                           Width="110"
                                           Minimum="0"
                                           Maximum="10"
                                           SmallChange="1"
                                           ValueChanged="OnNumberBoxChanged" />
                            </Grid>

                            <TextBlock x:Name="SubtitleStyleWarning"
                                       Style="{StaticResource CaptionTextStyle}"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>


