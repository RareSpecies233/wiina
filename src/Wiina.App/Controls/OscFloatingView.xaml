<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.OscFloatingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
    xmlns:local="using:Wiina.App.Controls"
    MinWidth="460"
    HorizontalAlignment="Left">

    <Grid>
        <Border x:Name="DragArea"
            Style="{StaticResource PanelBorderStyle}"
            Background="{ThemeResource ChromeSolidBrush}"
            MinHeight="64"
            Padding="12,6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" MinHeight="18" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <local:VolumeSlider x:Name="VolumeGroup"
                                    VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="LeftSpeed"
                               Text="{Binding SpeedText}"
                               Visibility="{Binding ShowSpeed, Converter={StaticResource BoolToVisibility}}"
                               Width="30"
                               TextAlignment="Right"
                               Style="{StaticResource CaptionTextStyle}" />
                    <Button Style="{StaticResource OscIconButtonStyle}"
                            Content="&#xE892;"
                            Command="{Binding PreviousCommand}"
                            loc:Loc.ToolTip="ui.previous"
                            loc:Loc.AutomationName="ui.previous" />
                    <Button Style="{StaticResource OscIconButtonStyle}"
                            Content="{Binding PlayGlyph}"
                            Command="{Binding PlayPauseCommand}"
                            FontSize="18"
                            loc:Loc.ToolTip="ui.playPauseSlash"
                            loc:Loc.AutomationName="ui.playPause" />
                    <Button Style="{StaticResource OscIconButtonStyle}"
                            Content="&#xE893;"
                            Command="{Binding NextCommand}"
                            loc:Loc.ToolTip="ui.next"
                            loc:Loc.AutomationName="ui.next" />
                    <TextBlock x:Name="RightSpeed"
                               Text="{Binding SpeedText}"
                               Visibility="{Binding ShowSpeed, Converter={StaticResource BoolToVisibility}}"
                               Width="30"
                               TextAlignment="Left"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>

                <local:OscToolbar x:Name="ToolbarGroup"
                                  Grid.Column="2"
                                  VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CurrentTimeLabel"
                           Text="{Binding CurrentTimeText}"
                           Width="46"
                           TextAlignment="Center"
                           Style="{StaticResource CaptionTextStyle}" />
                <local:TimelineControl x:Name="InnerTimeline"
                                       Grid.Column="1"
                                       Margin="4,0" />
                <TextBlock x:Name="DurationLabel"
                           Grid.Column="2"
                           Text="{Binding DurationText}"
                           Width="46"
                           TextAlignment="Center"
                           Style="{StaticResource CaptionTextStyle}" />
            </Grid>
        </Grid>
    </Border>
    </Grid>
</UserControl>


