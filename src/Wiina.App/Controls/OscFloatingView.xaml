<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Wiina.App.Controls.OscFloatingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Wiina.App.Controls"
    Width="460">

    <Border x:Name="DragArea"
            Style="{StaticResource PanelBorderStyle}"
            Height="64"
            Padding="12,6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="18" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <local:VolumeSlider x:Name="VolumeGroup"
                                    VerticalAlignment="Center" />

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="LeftSpeed"
                               Text="{Binding SpeedText}"
                               Visibility="{Binding ShowSpeed, Converter={StaticResource BoolToVisibility}}"
                               Width="30"
                               TextAlignment="Right"
                               Style="{StaticResource CaptionTextStyle}" />
                    <Button Style="{StaticResource OscIconButtonStyle}"
                            Content="&#xE892;"
                            Command="{Binding PreviousCommand}"
                            ToolTipService.ToolTip="上一首"
                            AutomationProperties.Name="上一首" />
                    <Button Style="{StaticResource OscIconButtonStyle}"
                            Content="{Binding PlayGlyph}"
                            Command="{Binding PlayPauseCommand}"
                            FontSize="18"
                            ToolTipService.ToolTip="播放 / 暂停"
                            AutomationProperties.Name="播放或暂停" />
                    <Button Style="{StaticResource OscIconButtonStyle}"
                            Content="&#xE893;"
                            Command="{Binding NextCommand}"
                            ToolTipService.ToolTip="下一首"
                            AutomationProperties.Name="下一首" />
                    <TextBlock x:Name="RightSpeed"
                               Text="{Binding SpeedText}"
                               Visibility="{Binding ShowSpeed, Converter={StaticResource BoolToVisibility}}"
                               Width="30"
                               TextAlignment="Left"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>

                <local:OscToolbar x:Name="ToolbarGroup"
                                  Grid.Column="2"
                                  VerticalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="1" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CurrentTimeLabel"
                           Text="{Binding CurrentTimeText}"
                           Width="46"
                           TextAlignment="Center"
                           Style="{StaticResource CaptionTextStyle}" />
                <local:TimelineControl x:Name="InnerTimeline"
                                       Grid.Column="1"
                                       Margin="4,0" />
                <TextBlock x:Name="DurationLabel"
                           Grid.Column="2"
                           Text="{Binding DurationText}"
                           Width="46"
                           TextAlignment="Center"
                           Style="{StaticResource CaptionTextStyle}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
