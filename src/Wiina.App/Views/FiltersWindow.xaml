<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wiina.App.Views.FiltersWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Wiina.App.Controls">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="18,12,18,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText"
                       Text="视频滤镜"
                       FontSize="19"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="VideoTabButton"
                              Content="视频"
                              IsChecked="True"
                              Click="OnTabClick"
                              Tag="video" />
                <ToggleButton x:Name="AudioTabButton"
                              Content="音频 / 均衡器"
                              Click="OnTabClick"
                              Tag="audio" />
            </StackPanel>
            <TextBlock Grid.Column="2"
                       Text="更改即时写入 mpv；保存后重启仍会恢复。"
                       FontSize="11"
                       Opacity="0.55"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,12,0" />
            <Button Grid.Column="3" Content="关闭" Click="OnCloseClick" />
        </Grid>

        <!-- Video page -->
        <Grid x:Name="VideoPanel" Grid.Row="1" Padding="18,4,18,8" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="活动视频滤镜" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="VideoCountText"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   Opacity="0.55" />
                    </Grid>
                    <ListView x:Name="VideoFilterList"
                              Grid.Row="1"
                              MinHeight="220"
                              SelectionMode="Single"
                              SelectionChanged="OnVideoSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Padding="0,4">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}"
                                               FontSize="11"
                                               Opacity="0.62"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding State}"
                                               FontSize="10"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="VideoAddButton" Content="添加" Click="OnVideoAddClick" />
                            <Button x:Name="VideoRemoveButton" Content="删除" Click="OnVideoRemoveClick" />
                            <Button x:Name="VideoToggleButton" Content="启用/停用" Click="OnVideoToggleClick" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="VideoUpButton" Content="上移" Click="OnVideoUpClick" />
                            <Button x:Name="VideoDownButton" Content="下移" Click="OnVideoDownClick" />
                            <Button x:Name="VideoClearButton" Content="清空" Click="OnVideoClearClick" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                        <StackPanel x:Name="VideoEditorPanel" Spacing="10">
                            <TextBlock Text="选择一个滤镜以编辑参数。"
                                       FontSize="12"
                                       Opacity="0.6" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="命名预设" Style="{StaticResource SectionTitleStyle}" />
                            <ComboBox x:Name="VideoPresetBox"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="选择已保存的视频滤镜预设" />
                            <TextBox x:Name="VideoPresetName"
                                     PlaceholderText="预设名称，例如：动画锐化"
                                     MaxLength="60" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="保存当前" Click="OnVideoPresetSaveClick" />
                                <Button Content="载入所选" Click="OnVideoPresetLoadClick" />
                                <Button Content="删除所选" Click="OnVideoPresetDeleteClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Audio page -->
        <Grid x:Name="AudioPanel"
              Grid.Row="1"
              Padding="18,4,18,8"
              ColumnSpacing="14"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9E9;" FontSize="14"
                                              Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock Text="10 段均衡器" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="EqualizerSwitch"
                                              HorizontalAlignment="Right"
                                              MinWidth="0"
                                              OnContent="启用"
                                              OffContent="停用"
                                              Toggled="OnEqualizerToggled" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="EqualizerPresetBox"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnEqualizerPresetChanged" />
                                <Button Grid.Column="1" Content="重置" Click="OnEqualizerResetClick" />
                            </Grid>
                            <controls:EqualizerView x:Name="EqView"
                                                    GainsChanged="OnEqualizerGainsChanged" />
                            <TextBlock Text="31 Hz – 16 kHz · 每段 −12…+12 dB"
                                       FontSize="10"
                                       Opacity="0.5" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="附加音频滤镜" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="AudioCountText"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           Opacity="0.55" />
                            </Grid>
                            <ListView x:Name="AudioFilterList"
                                      MinHeight="130"
                                      SelectionMode="Single"
                                      SelectionChanged="OnAudioSelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2" Padding="0,4">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}"
                                                       FontSize="11"
                                                       Opacity="0.62"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding State}"
                                                       FontSize="10"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="添加" Click="OnAudioAddClick" />
                                <Button Content="删除" Click="OnAudioRemoveClick" />
                                <Button Content="启用/停用" Click="OnAudioToggleClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                        <StackPanel x:Name="AudioEditorPanel" Spacing="10">
                            <TextBlock Text="选择一个附加音频滤镜以编辑参数。"
                                       FontSize="12"
                                       Opacity="0.6" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock Text="音频预设" Style="{StaticResource SectionTitleStyle}" />
                            <ComboBox x:Name="AudioPresetBox"
                                      HorizontalAlignment="Stretch"
                                      PlaceholderText="选择已保存的音频预设" />
                            <TextBox x:Name="AudioPresetName"
                                     PlaceholderText="预设名称，例如：夜间对白"
                                     MaxLength="60" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="保存当前" Click="OnAudioPresetSaveClick" />
                                <Button Content="载入所选" Click="OnAudioPresetLoadClick" />
                                <Button Content="删除所选" Click="OnAudioPresetDeleteClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="本机 libmpv 能力说明"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="UnsupportedText"
                                       FontSize="11"
                                       Opacity="0.62"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Padding="18,6,18,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       FontSize="11"
                       Opacity="0.68"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="mpv vf / af"
                       FontSize="10"
                       Opacity="0.4"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
