<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wiina.App.Views.FiltersWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
    xmlns:controls="using:Wiina.App.Controls">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Padding="18,12,18,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText"
                       loc:Loc.Text="ui.videoFilters"
                       FontSize="19"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <ToggleButton x:Name="VideoTabButton"
                              loc:Loc.Content="osd.track.video"
                              IsChecked="True"
                              Click="OnTabClick"
                              Tag="video" />
                <ToggleButton x:Name="AudioTabButton"
                              loc:Loc.Content="ui.audioEq"
                              Click="OnTabClick"
                              Tag="audio" />
            </StackPanel>
            <TextBlock Grid.Column="2"
                       loc:Loc.Text="ui.changesImmediate"
                       FontSize="11"
                       Opacity="0.55"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,0,12,0" />
            <Button Grid.Column="3" loc:Loc.Content="ui.close" Click="OnCloseClick" />
        </Grid>

        <!-- Video page -->
        <Grid x:Name="VideoPanel" Grid.Row="1" Padding="18,4,18,8" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock loc:Loc.Text="ui.activeVideoFilters" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="VideoCountText"
                                   HorizontalAlignment="Right"
                                   FontSize="11"
                                   Opacity="0.55" />
                    </Grid>
                    <ListView x:Name="VideoFilterList"
                              Grid.Row="1"
                              MinHeight="220"
                              SelectionMode="Single"
                              SelectionChanged="OnVideoSelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Padding="0,4">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Summary}"
                                               FontSize="11"
                                               Opacity="0.62"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding State}"
                                               FontSize="10"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Row="2" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="VideoAddButton" loc:Loc.Content="ui.add" Click="OnVideoAddClick" />
                            <Button x:Name="VideoRemoveButton" loc:Loc.Content="ui.delete" Click="OnVideoRemoveClick" />
                            <Button x:Name="VideoToggleButton" loc:Loc.Content="ui.toggleEnabled" Click="OnVideoToggleClick" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button x:Name="VideoUpButton" loc:Loc.Content="ui.moveUp" Click="OnVideoUpClick" />
                            <Button x:Name="VideoDownButton" loc:Loc.Content="ui.moveDown" Click="OnVideoDownClick" />
                            <Button x:Name="VideoClearButton" loc:Loc.Content="ui.clearShort" Click="OnVideoClearClick" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                        <StackPanel x:Name="VideoEditorPanel" Spacing="10">
                            <TextBlock loc:Loc.Text="ui.selectFilter"
                                       FontSize="12"
                                       Opacity="0.6" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock loc:Loc.Text="ui.namedPreset" Style="{StaticResource SectionTitleStyle}" />
                            <ComboBox x:Name="VideoPresetBox"
                                      HorizontalAlignment="Stretch"
                                      loc:Loc.Placeholder="ui.videoPresetPlaceholder" />
                            <TextBox x:Name="VideoPresetName"
                                     loc:Loc.Placeholder="ui.videoPresetExample"
                                     MaxLength="60" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button loc:Loc.Content="ui.saveCurrent" Click="OnVideoPresetSaveClick" />
                                <Button loc:Loc.Content="ui.loadSelected" Click="OnVideoPresetLoadClick" />
                                <Button loc:Loc.Content="ui.deleteSelected" Click="OnVideoPresetDeleteClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Audio page -->
        <Grid x:Name="AudioPanel"
              Grid.Row="1"
              Padding="18,4,18,8"
              ColumnSpacing="14"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9E9;" FontSize="14"
                                              Foreground="{ThemeResource SecondaryTextBrush}" />
                                    <TextBlock loc:Loc.Text="ui.eq10" Style="{StaticResource SectionTitleStyle}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="EqualizerSwitch"
                                              HorizontalAlignment="Right"
                                              MinWidth="0"
                                              loc:Loc.OnContent="ui.enable"
                                              loc:Loc.OffContent="ui.disabled"
                                              Toggled="OnEqualizerToggled" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="EqualizerPresetBox"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnEqualizerPresetChanged" />
                                <Button Grid.Column="1" loc:Loc.Content="ui.reset" Click="OnEqualizerResetClick" />
                            </Grid>
                            <controls:EqualizerView x:Name="EqView"
                                                    GainsChanged="OnEqualizerGainsChanged" />
                            <TextBlock loc:Loc.Text="ui.eqRange"
                                       FontSize="10"
                                       Opacity="0.5" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock loc:Loc.Text="ui.audioFilters" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock x:Name="AudioCountText"
                                           HorizontalAlignment="Right"
                                           FontSize="11"
                                           Opacity="0.55" />
                            </Grid>
                            <ListView x:Name="AudioFilterList"
                                      MinHeight="130"
                                      SelectionMode="Single"
                                      SelectionChanged="OnAudioSelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="2" Padding="0,4">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}"
                                                       FontSize="11"
                                                       Opacity="0.62"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding State}"
                                                       FontSize="10"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button loc:Loc.Content="ui.add" Click="OnAudioAddClick" />
                                <Button loc:Loc.Content="ui.delete" Click="OnAudioRemoveClick" />
                                <Button loc:Loc.Content="ui.toggleEnabled" Click="OnAudioToggleClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                        <StackPanel x:Name="AudioEditorPanel" Spacing="10">
                            <TextBlock loc:Loc.Text="ui.selectAudioFilter"
                                       FontSize="12"
                                       Opacity="0.6" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="14">
                        <StackPanel Spacing="8">
                            <TextBlock loc:Loc.Text="ui.audioPreset" Style="{StaticResource SectionTitleStyle}" />
                            <ComboBox x:Name="AudioPresetBox"
                                      HorizontalAlignment="Stretch"
                                      loc:Loc.Placeholder="ui.audioPresetPlaceholder" />
                            <TextBox x:Name="AudioPresetName"
                                     loc:Loc.Placeholder="ui.audioPresetExample"
                                     MaxLength="60" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button loc:Loc.Content="ui.saveCurrent" Click="OnAudioPresetSaveClick" />
                                <Button loc:Loc.Content="ui.loadSelected" Click="OnAudioPresetLoadClick" />
                                <Button loc:Loc.Content="ui.deleteSelected" Click="OnAudioPresetDeleteClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorderStyle}" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock loc:Loc.Text="ui.libmpvCapabilities"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="UnsupportedText"
                                       FontSize="11"
                                       Opacity="0.62"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="2" Padding="18,6,18,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       FontSize="11"
                       Opacity="0.68"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1"
                       Text="mpv vf / af"
                       FontSize="10"
                       Opacity="0.4"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>


