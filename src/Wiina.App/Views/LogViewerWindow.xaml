<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wiina.App.Views.LogViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
>

    <Grid x:Name="RootGrid" Background="{ThemeResource WindowTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Extended titlebar: same WinUI acrylic frame as the other secondary
             windows instead of the stock system caption. -->
        <Grid x:Name="DragRegion"
              Grid.Row="0"
              Padding="18,0,140,0"
              Background="Transparent">
            <TextBlock loc:Loc.Text="log.title"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource SecondaryTextBrush}" />
        </Grid>

        <!-- Header: identity on the left, log controls on the right. -->
        <Grid Grid.Row="1" Padding="18,10,18,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock loc:Loc.Text="log.title"
                           Style="{StaticResource TitleTextStyle}"
                           FontSize="19" />
                <TextBlock x:Name="PathText"
                           Style="{StaticResource CaptionTextStyle}"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <ComboBox x:Name="FilterBox"
                          Width="140"
                          loc:Loc.AutomationName="log.title"
                          SelectionChanged="OnFilterChanged" />
                <ToggleSwitch x:Name="AutoRefreshSwitch"
                              MinWidth="0"
                              loc:Loc.AutomationName="ui.autoRefresh"
                              loc:Loc.OnContent="ui.autoRefresh"
                              loc:Loc.OffContent="ui.manual"
                              Toggled="OnAutoRefreshToggled" />
                <Button loc:Loc.Content="ui.refresh"
                        loc:Loc.AutomationName="ui.refresh"
                        Click="OnRefreshClick" />
                <Button loc:Loc.Content="ui.openFolder"
                        loc:Loc.AutomationName="ui.openFolder"
                        Click="OnOpenFolderClick" />
                <Button loc:Loc.Content="ui.copy"
                        loc:Loc.AutomationName="ui.copy"
                        Click="OnCopyClick" />
            </StackPanel>
        </Grid>

        <!-- Body: one card so the log surface matches the settings cards. -->
        <Border Grid.Row="2"
                Style="{StaticResource CardBorderStyle}"
                Margin="18,0,18,16"
                Padding="10">
            <TextBox x:Name="LogText"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     FontFamily="Consolas"
                     FontSize="12"
                     IsSpellCheckEnabled="False"
                     BorderThickness="0"
                     Background="Transparent"
                     TextWrapping="NoWrap"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     loc:Loc.AutomationName="log.title" />
        </Border>
    </Grid>
</Window>
