<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wiina.App.Views.LogViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    Padding="12,8">
            <ComboBox x:Name="FilterBox"
                      Width="120"
                      SelectionChanged="OnFilterChanged" />
            <ToggleSwitch x:Name="AutoRefreshSwitch"
                          OnContent="自动刷新"
                          OffContent="手动"
                          Toggled="OnAutoRefreshToggled" />
            <TextBlock x:Name="PathText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Opacity="0.6"
                       MaxWidth="300" />
            <Button Content="刷新" Click="OnRefreshClick" />
            <Button Content="打开文件夹" Click="OnOpenFolderClick" />
            <Button Content="复制" Click="OnCopyClick" />
        </StackPanel>

        <TextBox x:Name="LogText"
                 Grid.Row="1"
                 Margin="12,0,12,12"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 FontSize="12"
                 IsSpellCheckEnabled="False" />
    </Grid>
</Window>
