<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wiina.App.Views.KeyBindingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:Wiina.App.Controls"
    xmlns:loc="using:Wiina.App.Localization"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{ThemeResource DialogSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="DragRegion"
            Height="44"
            Padding="16,0,140,0"
            ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon
                FontSize="15"
                Glyph="&#xE765;"
                Foreground="{ThemeResource SecondaryTextBrush}"
                VerticalAlignment="Center" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="13"
                FontWeight="SemiBold"
                loc:Loc.Text="keybindings.windowTitle" />
        </Grid>

        <Border
            Grid.Row="1"
            Margin="12,0,12,12"
            Padding="20,16,20,16"
            Background="{ThemeResource SettingsPageWashBrush}"
            BorderBrush="{ThemeResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
            <controls:KeyBindingsEditor x:Name="Editor" />
        </Border>
    </Grid>
</Window>
