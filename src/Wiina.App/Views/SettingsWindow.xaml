<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wiina.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid"
          MinWidth="560"
          MinHeight="420"
          Background="{ThemeResource AppBackgroundBrush}">
        <Grid.Resources>
            <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="SettingsNavButtonSelectedStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource SettingsNavButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SidebarTabSelectedBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource SidebarTabSelectedBorderBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="SettingsActionButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="10,2" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource PanelBorderBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="SettingsSectionButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TertiaryTextBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Extended titlebar: drag region + system caption buttons. -->
        <Grid x:Name="DragRegion"
              Grid.Row="0"
              Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center">
                <FontIcon Glyph="&#xE713;"
                          FontSize="14"
                          Foreground="{ThemeResource SecondaryTextBrush}" />
                <TextBlock Text="Wiina 设置"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource SecondaryTextBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource SidebarAcrylicBrush}"
                    BorderBrush="{ThemeResource PanelBorderBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SearchBox"
                             Grid.Row="0"
                             Margin="10,8,10,4"
                             PlaceholderText="搜索设置"
                             FontSize="12"
                             TextChanged="OnSearchChanged"
                             KeyDown="OnSearchKeyDown" />

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,0,8">
                        <StackPanel x:Name="NavPanel"
                                    Margin="8,2,8,8"
                                    Spacing="1" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,10,16,8" Spacing="2">
                    <TextBlock x:Name="PageTitle"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource PrimaryTextBrush}" />
                    <TextBlock x:Name="PageSummary"
                               Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="SectionPanel"
                                Orientation="Horizontal"
                                Spacing="12"
                                Margin="0,4,0,0" />
                </StackPanel>

                <ScrollViewer x:Name="PageScroll"
                              Grid.Row="1"
                              Padding="20,0,14,0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PagePanel"
                                Padding="0,0,4,24"
                                Spacing="0" />
                </ScrollViewer>

                <Border Grid.Row="2"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{ThemeResource PanelBorderBrush}"
                        Padding="20,7">
                    <Grid>
                        <TextBlock x:Name="StatusText"
                                   Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="更改立即应用并保存"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource CaptionTextStyle}" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Search popover list (spec §12.2); opens under the search box. -->
            <Border x:Name="SearchPanel"
                    Grid.ColumnSpan="2"
                    Width="360"
                    MaxHeight="320"
                    Margin="8,46,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Padding="4"
                    Visibility="Collapsed"
                    Background="{ThemeResource PanelBrush}"
                    BorderBrush="{ThemeResource PanelBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Canvas.ZIndex="20">
                <ListView x:Name="SearchList"
                          MaxHeight="312"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="OnSearchResultClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="1" Padding="2,4">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13"
                                           Foreground="{ThemeResource PrimaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="11"
                                           Foreground="{ThemeResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</Window>
