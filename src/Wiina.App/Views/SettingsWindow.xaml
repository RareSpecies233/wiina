<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wiina.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
>

    <Grid x:Name="RootGrid"
          MinWidth="600"
          MinHeight="440"
          Background="{ThemeResource WindowTintBrush}">
        <Grid.Resources>
            <Style x:Key="SettingsNavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style x:Key="SettingsNavButtonSelectedStyle"
                   TargetType="Button"
                   BasedOn="{StaticResource SettingsNavButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource SidebarTabSelectedBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource SidebarTabSelectedBorderBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="SettingsActionButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="10,2" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{ThemeResource PanelBorderBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="SettingsSectionButtonStyle" TargetType="Button">
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{ThemeResource TertiaryTextBrush}" />
                <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Extended titlebar: drag region + search box + system caption buttons. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="DragRegion"
                  Grid.Column="0"
                  Grid.ColumnSpan="3"
                  Background="Transparent">
                <TextBlock loc:Loc.Text="ui.wiinaSettings"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource SecondaryTextBrush}" />
            </Grid>

            <TextBox x:Name="SearchBox"
                     Grid.ColumnSpan="3"
                     Width="280"
                     Height="32"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     loc:Loc.Placeholder="ui.searchSettings"
                     FontSize="12"
                     TextChanged="OnSearchChanged"
                     KeyDown="OnSearchKeyDown" />

            <!-- The titlebar remains draggable to the right of the search box;
                 a transparent strip receives the drag explicitly because the
                 centered TextBox otherwise owns that pointer region. -->
            <Border x:Name="TitleDragRight"
                    Grid.Column="2"
                    Background="Transparent"
                    PointerPressed="OnTitleDragPressed"
                    PointerMoved="OnTitleDragMoved"
                    PointerReleased="OnTitleDragReleased"
                    PointerCaptureLost="OnTitleDragCaptureLost" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- The rail is transparent so the window tint is identical across
                 rail and content (no divider line). -->
            <Border Grid.Column="0" Background="Transparent">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Padding="0,0,0,8">
                    <StackPanel x:Name="NavPanel"
                                Margin="8,8,8,8"
                                Spacing="1" />
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Margin="20,10,16,8" Spacing="2">
                    <TextBlock x:Name="PageTitle"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource PrimaryTextBrush}" />
                    <TextBlock x:Name="PageSummary"
                               Style="{StaticResource CaptionTextStyle}"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="SectionPanel"
                                Orientation="Horizontal"
                                Spacing="12"
                                Margin="0,4,0,0" />
                </StackPanel>

                <ScrollViewer x:Name="PageScroll"
                              Grid.Row="1"
                              Padding="20,0,14,0"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PagePanel"
                                Padding="0,0,4,24"
                                Spacing="0" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Search popover list (spec §12.2); opens under the search box. -->
        <Border x:Name="SearchPanel"
                Grid.Row="0"
                Grid.RowSpan="2"
                Width="280"
                MaxHeight="320"
                Margin="0,52,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Padding="4"
                Visibility="Collapsed"
                Background="{ThemeResource PanelBrush}"
                BorderBrush="{ThemeResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Canvas.ZIndex="20">
            <ListView x:Name="SearchList"
                      MaxHeight="312"
                      SelectionMode="Single"
                      IsItemClickEnabled="True"
                      ItemClick="OnSearchResultClick">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="1" Padding="2,4">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="13"
                                       Foreground="{ThemeResource PrimaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}"
                                       FontSize="11"
                                       Foreground="{ThemeResource SecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Window>


