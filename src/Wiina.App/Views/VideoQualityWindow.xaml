<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wiina.App.Views.VideoQualityWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Wiina.App.Views">

    <Grid x:Name="RootGrid" Background="{ThemeResource WindowTintBrush}">
        <Grid.Resources>
            <DataTemplate x:Key="ScalerItemTemplate" x:DataType="views:ScalerOption">
                <TextBlock Text="{x:Bind Display}"
                           ToolTipService.ToolTip="{x:Bind Tooltip}"
                           TextWrapping="Wrap" />
            </DataTemplate>
            <DataTemplate x:Key="ProfileItemTemplate" x:DataType="views:ProfileOption">
                <TextBlock Text="{x:Bind Display}"
                           ToolTipService.ToolTip="{x:Bind Hint}"
                           TextWrapping="Wrap" />
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="DragRegion" Grid.Row="0" Padding="20,0,140,0" Background="Transparent">
            <TextBlock Text="画质预设" VerticalAlignment="Center"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="{ThemeResource SecondaryTextBrush}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="20,12,20,4" Spacing="4">
            <TextBlock Text="画质预设" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="管理 mpv 缩放、色度缩放与去色带 profile；下拉项会标注画质与性能取舍，设置保存后会立即应用到当前播放窗口。"
                       FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="20,12,20,12" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Profile" VerticalAlignment="Center" FontSize="13" />
                        <ComboBox x:Name="ProfileBox" Grid.Column="1" HorizontalAlignment="Stretch"
                                  ItemTemplate="{StaticResource ProfileItemTemplate}"
                                  SelectionChanged="OnProfileSelected" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <Button Content="新建" Click="OnAddClick" />
                            <Button Content="重命名" Click="OnRenameClick" />
                            <Button Content="删除" Click="OnDeleteClick" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ProfileHintText" Margin="0,2,0,0" FontSize="11.5" Opacity="0.6"
                               TextWrapping="Wrap" />
                </StackPanel>

                <Border Background="{ThemeResource SettingsCardWashBrush}" BorderBrush="{ThemeResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="14">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="放大缩放 (scale)" VerticalAlignment="Center" />
                                <ComboBox x:Name="ScaleBox" Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemTemplate="{StaticResource ScalerItemTemplate}"
                                          SelectionChanged="OnScalerChanged" />
                            </Grid>
                            <TextBlock Margin="160,0,0,0" FontSize="11.5" Opacity="0.6" TextWrapping="Wrap"
                                       Text="放大画面（如 1080p→4K）时使用，越锐利越吃 GPU：日常选 EWA Lanczos，弱 GPU 选 Bilinear。" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="缩小缩放 (dscale)" VerticalAlignment="Center" />
                                <ComboBox x:Name="DscaleBox" Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemTemplate="{StaticResource ScalerItemTemplate}"
                                          SelectionChanged="OnScalerChanged" />
                            </Grid>
                            <TextBlock Margin="160,0,0,0" FontSize="11.5" Opacity="0.6" TextWrapping="Wrap"
                                       Text="缩小画面（如 4K→1080p）时使用：Mitchell 平滑、不易闪烁；追求锐度选 Lanczos / Spline36；弱 GPU 选 Bilinear。" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="色度缩放 (cscale)" VerticalAlignment="Center" />
                                <ComboBox x:Name="CscaleBox" Grid.Column="1" HorizontalAlignment="Stretch"
                                          ItemTemplate="{StaticResource ScalerItemTemplate}"
                                          SelectionChanged="OnScalerChanged" />
                            </Grid>
                            <TextBlock Margin="160,0,0,0" FontSize="11.5" Opacity="0.6" TextWrapping="Wrap"
                                       Text="只缩放色彩（色度）平面，影响彩边锐度而非亮度细节：Bilinear 最省，Bicubic / Spline36 色彩边缘更清晰。" />
                        </StackPanel>

                        <TextBlock x:Name="RawKeyText" FontSize="11" Opacity="0.55" TextWrapping="Wrap" />

                        <ToggleSwitch x:Name="DebandSwitch" Header="去色带 (deband)" OnContent="开" OffContent="关"
                                      Toggled="OnDebandToggled" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="20,0,20,16" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Content="导入 JSON…" Click="OnImportClick" />
                <Button Content="导出 JSON…" Click="OnExportClick" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                <Button Content="应用" Click="OnApplyClick" Style="{StaticResource AccentButtonStyle}" />
                <Button Content="关闭" Click="OnCloseClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
