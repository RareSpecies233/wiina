<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wiina.App.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
>

    <Grid x:Name="RootGrid"
          Background="{ThemeResource WindowTintBrush}"
          Padding="24"
          RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14">
            <!-- Brand tile: the packaged PNG is the yellow triangle only, so the
                 white rounded tile is drawn here (matches the app icon). -->
            <Border Width="68"
                    Height="68"
                    CornerRadius="15"
                    Background="{ThemeResource BrandTileBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1">
                <Image Source="ms-appx:///Assets/wiina.png"
                       Width="50"
                       Height="50"
                       Stretch="Uniform"
                       AutomationProperties.Name="Wiina" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Wiina"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{ThemeResource PrimaryTextBrush}" />
                <TextBlock x:Name="VersionText"
                           FontSize="12"
                           Foreground="{ThemeResource SecondaryTextBrush}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="InfoPanel" Spacing="7" />
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock loc:Loc.Text="ui.licenseShort"
                       Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    loc:Loc.Content="ui.copyInfo"
                    Click="OnCopyClick" />
            <Button Grid.Column="2"
                    loc:Loc.Content="ui.close"
                    Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>


