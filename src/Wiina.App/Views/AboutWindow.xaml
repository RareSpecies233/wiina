<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wiina.App.Views.AboutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource AppBackgroundBrush}"
          Padding="24"
          RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14">
            <Border Width="56"
                    Height="56"
                    CornerRadius="12"
                    Background="{ThemeResource CardBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1">
                <FontIcon Glyph="&#xE8B7;"
                          FontSize="26"
                          Foreground="{ThemeResource AccentBrush}" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Wiina"
                           FontSize="20"
                           FontWeight="Bold" />
                <TextBlock x:Name="VersionText"
                           FontSize="12"
                           Foreground="{ThemeResource SecondaryTextBrush}" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="InfoPanel" Spacing="7" />
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="GPL-3.0-only · 无担保"
                       Style="{StaticResource CaptionTextStyle}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="复制信息"
                    Click="OnCopyClick" />
            <Button Grid.Column="2"
                    Content="关闭"
                    Click="OnCloseClick" />
        </Grid>
    </Grid>
</Window>
