<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wiina.App.Views.InspectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
>

    <Grid x:Name="RootGrid" Background="{ThemeResource WindowTintBrush}">
        <Grid.Resources>
            <!-- Generated group cards reuse the settings/sidebar card chrome so
                 the inspector follows the theme instead of a gray wash. -->
            <Style x:Key="InspectorCardStyle"
                   TargetType="Border"
                   BasedOn="{StaticResource CardBorderStyle}">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Extended titlebar, same acrylic frame as the settings window. -->
        <Grid x:Name="DragRegion"
              Grid.Row="0"
              Padding="18,0,140,0"
              Background="Transparent">
            <TextBlock loc:Loc.Text="inspector.title"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource SecondaryTextBrush}" />
        </Grid>

        <!-- Header: live title on the left, refresh controls on the right. -->
        <Grid Grid.Row="1" Padding="18,10,18,10" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TitleText"
                       loc:Loc.Text="inspector.title"
                       Style="{StaticResource TitleTextStyle}"
                       FontSize="19"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <ToggleSwitch x:Name="AutoRefreshSwitch"
                              MinWidth="0"
                              loc:Loc.AutomationName="ui.autoRefresh"
                              loc:Loc.OnContent="ui.auto"
                              loc:Loc.OffContent="ui.manual"
                              Toggled="OnAutoRefreshToggled" />
                <Button loc:Loc.Content="ui.refresh"
                        loc:Loc.AutomationName="ui.refresh"
                        Click="OnRefreshClick" />
                <Button loc:Loc.Content="ui.copy"
                        loc:Loc.AutomationName="ui.copy"
                        Click="OnCopyClick" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      Padding="18,0,18,16"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel" Spacing="8" />
        </ScrollViewer>
    </Grid>
</Window>
