<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wiina.App.Views.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Wiina.App.Localization"
>

    <Grid x:Name="RootGrid"
          MinWidth="480"
          MinHeight="360"
          Background="{ThemeResource WindowTintBrush}"
          AllowDrop="True"
          DragOver="OnDragOver"
          Drop="OnDropAsync">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="DragRegion" Grid.Row="0" Background="Transparent">
            <TextBlock Text="Wiina"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource SecondaryTextBrush}" />
        </Grid>

        <Grid Grid.Row="1" Margin="30,8,30,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Identity -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="64"
                        Height="64"
                        CornerRadius="14"
                        Background="{ThemeResource CardBrush}"
                        BorderBrush="{ThemeResource CardBorderBrush}"
                        BorderThickness="1">
                    <FontIcon Glyph="&#xE8B7;"
                              FontSize="30"
                              Foreground="{ThemeResource AccentBrush}" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,2,0,0" Spacing="2">
                    <TextBlock Text="Wiina"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{ThemeResource PrimaryTextBrush}" />
                    <TextBlock Text="Windows-native, IINA-inspired mpv player"
                               FontSize="11"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="VersionText"
                               FontSize="11"
                               Foreground="{ThemeResource TertiaryTextBrush}" />
                </StackPanel>

                <Button Grid.Column="2"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="15"
                        FontFamily="{StaticResource IconFont}"
                        Content="&#xE946;"
                        Click="OnAboutClick"
                        loc:Loc.ToolTip="ui.about"
                        loc:Loc.AutomationName="ui.about" />
            </Grid>

            <!-- Primary actions -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="12"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right">
                <Button loc:Loc.Content="ui.openFileEllipsis"
                        Width="150"
                        Height="36"
                        Click="OnOpenFileClick"
                        loc:Loc.AutomationName="ui.openFile" />
                <Button loc:Loc.Content="ui.openUrl"
                        Width="150"
                        Height="36"
                        Click="OnOpenUrlClick"
                        loc:Loc.AutomationName="ui.openUrlShort" />
            </StackPanel>

            <!-- Resume -->
            <Border x:Name="ResumeCard"
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    Padding="10,6"
                    CornerRadius="8"
                    Background="{ThemeResource CardBrush}"
                    BorderBrush="{ThemeResource CardBorderBrush}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    Tapped="OnResumeTapped">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE823;"
                              FontSize="14"
                              Foreground="{ThemeResource SecondaryTextBrush}" />
                    <TextBlock x:Name="ResumeTitle"
                               Grid.Column="1"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ResumePosition"
                               Grid.Column="2"
                               FontSize="11"
                               Foreground="{ThemeResource SecondaryTextBrush}"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Recent header -->
            <Grid Grid.Row="3" Margin="0,12,0,2">
                <TextBlock loc:Loc.Text="ui.recent"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button x:Name="ClearRecentButton"
                        loc:Loc.Content="ui.clear"
                        HorizontalAlignment="Right"
                        Padding="8,2"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="11"
                        Click="OnClearRecentClick" />
            </Grid>

            <Grid Grid.Row="4">
                <ListView x:Name="RecentList"
                          SelectionMode="Single"
                          IsItemClickEnabled="False"
                          DoubleTapped="OnRecentDoubleTapped"
                          MinHeight="72">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnSpacing="8" Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Subtitle}"
                                           FontSize="11"
                                           Opacity="0.6"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="RecentEmpty"
                           loc:Loc.Text="ui.noHistory"
                           FontSize="12"
                           Opacity="0.55"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>

            <TextBlock Grid.Row="5"
                       Margin="0,6,0,0"
                       loc:Loc.Text="ui.dragHint"
                       FontSize="11"
                       Foreground="{ThemeResource SecondaryTextBrush}"
                       TextWrapping="Wrap" />

            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        Spacing="4"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Right">
                <Button loc:Loc.Content="ui.settingsEllipsis"
                        Padding="8,2"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="11"
                        Click="OnSettingsClick" />
                <Button loc:Loc.Content="ui.openDataFolder"
                        Padding="8,2"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="11"
                        Click="OnOpenDataFolderClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>


