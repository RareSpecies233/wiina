<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Portable uninstaller (issue 8). Deliberately tiny and UI-framework free:
      the portable zip ships no installer, so "Uninstall Wiina.exe" next to
      Wiina.exe is the only uninstall entry point. A trimmed, compressed,
      single-file WinExe keeps it around 10 MB and start-up instant; the only
      UI is user32!MessageBoxW (see NativeMethods.cs).
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RootNamespace>Wiina.Uninstall</RootNamespace>
    <AssemblyName>Wiina.Uninstall</AssemblyName>
    <AssemblyTitle>Wiina Uninstaller</AssemblyTitle>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No WinForms/WPF: the uninstaller must not pull in a UI stack. -->
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <ApplicationIcon>..\Wiina.App\Assets\wiina.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Compiling the catalog source directly keeps the progids/extensions in
      sync with the app without dragging Wiina.Core (and its JSON settings
      stack) into a trimmed single-file executable.
    -->
    <Compile Include="..\Wiina.Core\Files\FileAssociationCatalog.cs"
             Link="FileAssociationCatalog.cs" />
  </ItemGroup>

</Project>
